        <br>  

        <span>学歴</span>
		<select class="form-select" name="type" style="width:40%">
            <option value="" selected="" disabled="" hidden="">高卒</option>
            <option value="develop_java">高卒</option>
            <option value="develop_java">専門卒</option>
            <option value="develop_java">大卒</option>
            <option value="develop_java">大学院卒</option>
