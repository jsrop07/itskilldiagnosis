<div class="btn-place" style="margin-top: 32px;">
	<button class="emegra cancel" onclick="history.back();">戻る</button>
	<?php if ($isRegister): ?>
		<button class="emegra" onclick="Regist();">承認</button>
	<?php endif; ?>
	<?php if ($isDeleter): ?>
		<button class="emegra delete" onclick="Delete();">削除</button>
		<button class="emegra" onclick="self.location.href='../edit/<?php echo $questionData['idx']; ?>';">修正</button>
	<?php endif; ?>
</div>

<script type="text/javascript">
	<?php if ($isRegister): ?>
		function Regist() {
			const postForm = new FormData();
			postForm.append("idxs", <?php echo $questionData["idx"]; ?>);

			const xhr = new XMLHttpRequest();
			xhr.open("POST", "../approve", true);
			xhr.send(postForm);
				
			xhr.onload = () => {
				if (xhr.status == 200) {
					const result = xhr.responseText;
					if (result == "success") {
						alert("承認しました。");
						self.location.href = "../list";
					}
					else { alert("Error"); }
					console.log(result);
				}
			}
		}
	<?php endif; ?>
	
	<?php if ($isDeleter): ?>
		function Delete() {
			const postForm = new FormData();
			postForm.append("idxs", <?php echo $questionData["idx"]; ?>);

			const xhr = new XMLHttpRequest();
			xhr.open("POST", "../delete", true);
			xhr.send(postForm);
				
			xhr.onload = () => {
				if (xhr.status == 200) {
					const result = xhr.responseText;
					if (result == "success") {
						alert("削除しました。");
						self.location.href = "../list";
					}
					else { alert("Error"); }
					console.log(result);
				}
			}
		}
	<?php endif; ?>
</script>