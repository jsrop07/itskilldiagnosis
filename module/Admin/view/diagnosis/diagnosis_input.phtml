<script type="text/javascript">
  const levelText = ["無級", "初級", "中級", "高級"];

  const diagnosisList = document.getElementById("table-diagnosis_list");
  const questionList = document.getElementById("table-question_list");
  const diagnosisCheckbox = document.getElementById("check-diagnosis");
  const questionCheckbox = document.getElementById("check-question");

  let class2ndDatas = {
    <?php foreach ($optionDatas["class1st"] as $class2stdata): ?>
      "<?php echo $class2stdata["idx"]; ?>":[
        <?php foreach ($optionDatas["class2nd"][$class2stdata["idx"]] as $class2ndData): ?>
          {"value":"<?php echo $class2ndData["idx"]; ?>", "text":"<?php echo $class2ndData["text"]; ?>"},
        <?php endforeach; ?>
      ],
    <?php endforeach; ?>
  };

  window.onload = function() {
    SetQuestionList();
  }

  window.onpageshow = function(event) {
    if(event.persisted || (window.performance && window.performance.navigation.type == 2)) {
      check_all.checked = false;
      for (let i = 0; i < checkElements.length; i++) {
        checkElements[i].checked = false;
      }
    }
  }

  function SetQuestionList(element = "") {
    if (element == form.question1st) {
      let selectbox = form.question2nd;
      selectbox.replaceChildren();

      var option = document.createElement("option");
      selectbox.disabled = true;

      if (element.value != "") {
        option.value = "";
        selectbox.appendChild(option);

        console.log(class2ndDatas);
        let datas = class2ndDatas[element.value];
        console.log(datas);
        for (let i = 0; i < datas.length; i++) {
          var option = document.createElement("option");
          option.value = datas[i]["value"];
          option.innerText = datas[i]["text"];
          selectbox.appendChild(option);
          console.log(option);
        }

        selectbox.disabled = false;
      }
    }

    let postData = new Array();
    if (form.question1st.value != "") { postData.push({"key":"class1st", "value":form.question1st.value}) }
    if (form.question2nd.value != "") { postData.push({"key":"class2nd", "value":form.question2nd.value}) }
    if (form.questionLevel.value != "") { postData.push({"key":"level", "value":form.questionLevel.value}) }

    const xhr = SendXhr("./read/question", postData);
    xhr.onload = () => {
      if (xhr.status == 200) {
        const result = xhr.responseText;
        try {
          questionDatas = JSON.parse(result);
          console.log(questionDatas);

          questionList.lastElementChild.replaceChildren();
          for (let i = 0; i < questionDatas.length; i++) {
            var tr = document.createElement("tr");

            var td = document.createElement("td");
            td.style.width = "60px";
            td.innerText = Number(i) + 1;
            tr.appendChild(td);

            var td = document.createElement("td");
            td.classList.add("start");
            td.innerText = questionDatas[i]["title"];
            tr.appendChild(td);

            var td = document.createElement("td");
            td.classList.add("start");
            td.style.width = "200px";
            td.innerText = questionDatas[i]["class1st"];
            tr.appendChild(td);

            var td = document.createElement("td");
            td.classList.add("start");
            td.style.width = "200px";
            td.innerText = questionDatas[i]["class2nd"];
            tr.appendChild(td);

            var td = document.createElement("td");
            td.style.width = "100px";
            td.innerText = levelText[questionDatas[i]["level"]];
            tr.appendChild(td);

            var td = document.createElement("td");
            td.style.width = "50px";
            td.innerText = questionDatas[i]["point"];
            tr.appendChild(td);

            var input = document.createElement("input");
            input.type = "checkbox";
            input.name = "check-question";
            input.value = questionDatas[i]["idx"];
            input.classList.add("checkbox");
            input.setAttribute("onClick", "Check(this);");

            var td = document.createElement("td");
            td.appendChild(input);
            td.style.width = "40px";
            tr.appendChild(td);

            questionList.lastElementChild.appendChild(tr);
          }
          questionCheckbox.checked = false;

          return true;
        } catch(e) {
          let alertString = ErrorString();
          alertString += "\nexception error in diagnosis_input SetQuestionList";
          alertString += "\nexception message: " + e;
          alert(alertString);
          console.log(result);

          return false;
        }
      }
      else {
        let alertString = ErrorString();
        alertString += "\nxhr error in diagnosis_input SetQuestionList";
        alertString += "\nerror code: " + xhr.status;
        alert(alertString);

        return false;
      }
    }
  }

  function Check(element) {
    console.log(typeof element.dataset.target);

    if (typeof element.dataset.target !== "undefined") {
      let checkboxs = document.getElementsByName(element.dataset.target);
      
      for (let i = 0; i < checkboxs.length; i++) {
        checkboxs[i].checked = element.checked;
      }
    }
    else {
      let checkboxs = document.getElementsByName(element.name);
      let allCheckbox = document.querySelectorAll("[data-target='"+ element.name + "']")[0];
      console.log(allCheckbox);

      let isAllChecked = true;
      for (let i = 0; i < checkboxs.length; i++) {
        if (checkboxs[i].checked == false) { isAllChecked = false; break; }
      }

      allCheckbox.checked = isAllChecked;
    }
  }

  function AddQuestion() {
    let checkboxs = document.querySelectorAll("input[name='check-question']:checked");
    
    for (let i = 0; i < checkboxs.length; i++) {
      checkboxs[i].checked = false;
      var tr = checkboxs[i].parentNode.parentNode.cloneNode(true);
      var input = tr.lastElementChild.firstElementChild;
      input.name = "check-diagnosis";
      diagnosisList.lastElementChild.appendChild(tr);

      checkboxs[i].parentNode.parentNode.hidden = true;
    }

    diagnosisCheckbox.checked = false;
    questionCheckbox.checked = false;
    NumberingList();
  }

  function RemoveQuestion() {
    let diagnosisCheckboxs = document.querySelectorAll("input[name='check-diagnosis']:checked");
    
    for (let i = 0; i < diagnosisCheckboxs.length; i++) {
      let questionCheckbox = document.querySelectorAll("input[name='check-question'][value='" + diagnosisCheckboxs[i].value + "']")[0];

      questionCheckbox.parentNode.parentNode.hidden = false;
      diagnosisCheckboxs[i].parentNode.parentNode.remove();
    }

    diagnosisCheckbox.checked = false;
    questionCheckbox.checked = false;
    NumberingList();
  }



  function SendXhr(route, datas = new Array()) {
    const postForm = new FormData();
    for (let i = 0; i < datas.length; i++) {
      postForm.append(datas[i]["key"], datas[i]["value"]);
    }

    const xhr = new XMLHttpRequest();
    xhr.open("POST", route, true);
    xhr.send(postForm);
    return xhr;
  }

  function ErrorString() {
    let alertString = "予期せぬエラーが発生しました。";
    alertString += "\n管理者にエラー内容をお知らせくださいますようお願いいたします。";
    alertString += "\n\nエラー内容：";
    return alertString;
  }

  function NumberingList() {
    let diagnosisCheckboxs = document.getElementsByName("check-diagnosis");
    for (let i = 0; i < diagnosisCheckboxs.length; i++) {
      diagnosisCheckboxs[i].parentNode.parentNode.firstElementChild.innerText = Number(i) + 1;
    }

    let questionCheckboxs = document.getElementsByName("check-question");
    let minus = 0
    for (let i = 0; i < questionCheckboxs.length; i++) {
      questionCheckboxs[i].parentNode.parentNode.firstElementChild.innerText = Number(i) + 1 - minus;
      if (questionCheckboxs[i].parentNode.parentNode.hidden == true) { minus++; }
    }
  }
</script>