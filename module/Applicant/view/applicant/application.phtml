            <option value="" selected="" disabled="" hidden="">男</option>
            <option value="develop_java">男</option>
            <option value="develop_java">女</option>
        </select>
        <br>  
        
        <span >応募区分</span>
        <select class="form-select" name="type" style="width:40%">
            <option value="" selected="" disabled="" hidden="">新卒</option>
            <option value="develop_java">新卒</option>
