				<dt class="essential">選択肢①</dt>
				<dd><input class="form-control" name="answer1" placeholder="選択肢①を入力してください"></dd>

				<dt class="essential">選択肢②</dt>
				<dd><input class="form-control" name="answer2" placeholder="選択肢①を入力してください"></dd>

