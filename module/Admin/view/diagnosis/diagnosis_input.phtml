        <?php endforeach; ?>
      ],
    <?php endforeach; ?>
  };

  let popoverTriggerList = new Array();
  let popoverList = new Array();



  window.onpageshow = function(event) {
    if (event.persisted || (window.performance && window.performance.navigation.type == 2)) {
      diagnosisCheckbox.checked = false;
      questionCheckbox.checked = false;
      form.question1st.value = "";
      form.question2nd.value = "";
      form.question2nd.disabled = true;
      form.question_level.value = "";
      SetDiagnosisList();
      SetQuestionList();
    }
    else {
      <?php if ($isEdit): ?>
        SetDiagnosisList();
      <?php endif; ?>
      SetQuestionList();
    }
  }



  function SetQuestionList(element = "") {
    if (element == form.question1st) {
      let selectbox = form.question2nd;
      selectbox.replaceChildren();

      var option = document.createElement("option");
      selectbox.disabled = true;

      if (element.value != "") {
        option.value = "";
        selectbox.appendChild(option);

        console.log(class2ndDatas);
        let datas = class2ndDatas[element.value];
        console.log(datas);
        for (let i = 0; i < datas.length; i++) {
          var option = document.createElement("option");
          option.value = datas[i]["value"];
          option.innerText = datas[i]["text"];
          selectbox.appendChild(option);
          console.log(option);
        }

        selectbox.disabled = false;
      }
    }

    let postData = new Array();
    if (form.question1st.value != "") { postData.push({"key":"class1st", "value":form.question1st.value}) }
    if (form.question2nd.value != "") { postData.push({"key":"class2nd", "value":form.question2nd.value}) }
    if (form.question_level.value != "") { postData.push({"key":"level", "value":form.question_level.value}) }

    const xhr = SendXhr("./read/question", postData);
    xhr.onload = () => {
      if (xhr.status == 200) {
        const result = xhr.responseText;
        try {
          questionDatas = JSON.parse(result);
          console.log(questionDatas);

          let questionIdxDatas = new Array();
          if (form.question_idxs.value != "") {
            questionIdxDatas = form.question_idxs.value.split(",");
          }

          questionList.lastElementChild.replaceChildren();
          for (let i = 0; i < questionDatas.length; i++) {
            var tr = document.createElement("tr");

            var td = document.createElement("td");
            td.style.width = "60px";
            td.innerText = Number(i) + 1;
            tr.appendChild(td);

            var td = document.createElement("td");
            td.classList.add("start");

            td.setAttribute("data-bs-toggle", "popover");
            td.setAttribute("data-bs-placement", "bottom");
            td.setAttribute("data-bs-title", ChangeToPopoverForm(questionDatas[i]["question"]));
            let popoverContent = numTextDatas[0] + (questionDatas[i]["answer1"]);
            for (let j = 2; j <= 5; j++) {
              if (questionDatas[i]["answer" + j] == null) { break; }
              popoverContent += "{{n}}" + numTextDatas[j - 1] + questionDatas[i]["answer" + j];
            }
            popoverContent = ChangeToPopoverForm(popoverContent);
            td.setAttribute("data-bs-content", popoverContent);
            td.setAttribute("data-bs-html", "true");

            td.innerText = questionDatas[i]["title"];
            tr.appendChild(td);

            var td = document.createElement("td");
            td.classList.add("start");
            td.innerText = questionDatas[i]["class1st"];
            tr.appendChild(td);

            var td = document.createElement("td");
            td.classList.add("start");
            td.innerText = questionDatas[i]["class2nd"];
            tr.appendChild(td);

            var td = document.createElement("td");
            td.innerText = levelText[questionDatas[i]["level"]];
            tr.appendChild(td);

            var td = document.createElement("td");
            td.innerText = questionDatas[i]["point"];
            tr.appendChild(td);

            var input = document.createElement("input");
            input.type = "checkbox";
            input.name = "check-question";
            input.value = questionDatas[i]["idx"];
            input.classList.add("checkbox");
            input.setAttribute("onClick", "Check(this);");

            for (let i = 0; i < questionIdxDatas.length; i++) {
              if (input.value == questionIdxDatas[i]) {
                tr.hidden = true;
                break;
              }
            }

            var td = document.createElement("td");
            td.appendChild(input);
            td.style.width = "40px";
            tr.appendChild(td);

            questionList.lastElementChild.appendChild(tr);
          }

          NumberingList();
          questionCheckbox.checked = false;
          SetPopover();

          return true;
        } catch(e) {
          let alertString = ErrorString();
          alertString += "\nexception error in diagnosis_input SetQuestionList";
          alertString += "\nexception message: " + e;
          alertString += "\nresponseText: " + result;
          alert(alertString);
          console.log(result);

          return false;
        }
      }
      else {
        let alertString = ErrorString();
        alertString += "\nxhr error in diagnosis_input SetQuestionList";
        alertString += "\nerror code: " + xhr.status;
        alert(alertString);

        return false;
      }
    }
  }

