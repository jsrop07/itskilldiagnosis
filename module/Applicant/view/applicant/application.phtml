<!-- 漢字カナ入力時有効性検査 -->
<script>
function emailValidationCheck(input){
    var emailValidation =  /^[A-Za-z0-9_\.\-]+@[A-Za-z0-9\-]+\.[A-Za-z0-9\-]+/;
    return emailValidation.test(input);
}

function checkKanji(input) {
    function toHalfWidth(str) {
        return str.replace(/[！-～]/g, function(s) {
            return String.fromCharCode(s.charCodeAt(0) - 0xFEE0);
        }).replace(/　/g, " ");
    }

    var halfWidthInput = toHalfWidth(input);
    var japaneseRegex = /^[\u4E00-\u9FFF\u3040-\u309F]+$/; // 
    var katakanaRegex = /^[\u30A0-\u30FF]+$/; // 

    return japaneseRegex.test(halfWidthInput) || katakanaRegex.test(halfWidthInput);
}


function checkKana(input) {
    var katakanaRegex = /^[\u30A0-\u30FFー]+$/; 
    return katakanaRegex.test(input);
}
</script>

<!-- 必須項目有効性検査 -->
<script>
    function applicationConfirm() {
        if (form.email.value == "" || !emailValidationCheck(form.email.value)) {
            alert("メールアドレスを入力してください。");
            setTimeout("form.email.focus()",100);
            return false;
        }

        if (form.name.value == "" || !checkKanji(form.name.value)) {
            alert("漢字を入力してください。");
            setTimeout("form.name.focus()",100);
            return false;
        }

        if (form.kana.value == "" || !checkKana(form.kana.value)) {
            alert("カナを入力してください。");
            setTimeout("form.kana.focus()",100);
            return false;
        }

        if (form.birth.value == "" ) {
            alert("生年月日を入力してください。");
            setTimeout("form.birth.focus()",100);
            return false;
        }
    
        if (form.case.value == "") {
            alert("応募区分を入力してください。");
            setTimeout("form.case.focus()",100);
            return false;
        }
        if (form.educationSelect.value == "") {
            alert("学歴入力してください。");
            setTimeout("form.educationSelect.focus()",100);
            return false;
        }

        if (form.educationSelect.value == "その他" && form.otherEducation.value=="") {
            alert("その他の場合の、記入してください。");
            setTimeout("form.educationSelect.focus()",100);
            return false;
        }

        if (form.skill.value == "") {
            alert("ITスキル有無を入力してください。");
            setTimeout("form.skill.focus()",100);
            return false;
        }

        if (!class1stSelect.disabled && form.class1stSelect.value === "") {
            alert("経験分野を入力してくださいsd。");
            setTimeout("form.class1stSelect.focus()",100);
            return false;
        }

        if (form.class1stSelect.value == "その他" && form.otherclass1st.value=="") {
            alert("その他の場合の、記入してください");
            setTimeout("form.class1stSelect.focus()",100);
            return false;
        }

        if (!careerInput.disabled && (isNaN(form.career.value) || form.career.value === "")) {
            alert("IT経験年数を入力してください。");
            setTimeout("form.careerInput.focus()",100);
            return false;
        }

        if (!typeSelect.disabled && form.typeSelect.value == "") {
            alert("問題種別を入力してください。");
            setTimeout("form.typeSelect.focus()",100);
            return false;
        }

        var myModal = new bootstrap.Modal(document.getElementById('exampleModal'), {
            keyboard: false
        });
        myModal.show();
    }
</script>

