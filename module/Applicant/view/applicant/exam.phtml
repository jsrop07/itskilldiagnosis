<script type="text/javascript">
	const form = document.getElementById("form");

	function check() {
		<?php foreach ($questionDatas as $index => $data): ?>
			var selected = Array.from(form.question<?= $index ?>).find(radio => radio.checked);
			if (selected == null) {
				alert("答えなかった問題があります。");
				form.question<?= $index ?>[0].focus();
				return false;
			}

			document.getElementById("answer<?= $index ?>").innerText = "<?= $index + 1 ?>. " + selected.value;
		<?php endforeach; ?>
		
		const modal = new bootstrap.Modal(document.getElementById("modal"), { keyboard: false });
		modal.show();
	}

	function submit() { form.submit(); }
</script>
