<div class="container-fluid">
<div class="diagnosis card">
    <div class="diagnosis_head">
    <!-- こんにちは。GNGサービスITスキル診断サイトです。<br/>
	下段に本人が該当する部分を作成してください。<br/> -->
    </div>

    <div class="diagnosis_main">
        <span for="email">メール </span>
		<input class="form-control" id="mail" type="email" placeholder="Emailを入力ください。" style="width:70%">
        <br>
        
		<span>お名前（漢字）</span>
		<input class="form-control" id="name" type="text" placeholder="漢字を記入してください。"style="width:40%">

