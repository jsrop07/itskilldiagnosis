    <script>
      const selectSelectKey = document.getElementById("select-select_key");
      const selectSelectValue = document.getElementById("select-select_value");
      const selectSelectClass = document.getElementById("select-select_class");

      function SelectKey(element) {
        let value = element.value;
        if (value == "") { Select(element); }

        selectSelectValue.replaceChildren();
        var option = document.createElement("option");
        option.value = "";
        selectSelectValue.appendChild(option);

        /*
          作成：朴昰成
          修正：朴昰成
          修正前：24/06/19
        */

        /* 修正前：
        if (value == "class") { selectSelectClass.disabled = false; }
        else { selectSelectClass.disabled = true; }
        */

        /* 修正後： */
        if (value == "class") {
          selectSelectClass.disabled = false;
        }
        else {
          selectSelectClass.replaceChildren();
          selectSelectClass.disabled = true;
        }
        /* ここまで */

        switch(value) {
          case "status":
            <?php foreach ($selectValueDatas["status"] as $data): ?>
              option = document.createElement("option");
              option.value = "<?php echo $data["idx"]; ?>";
              option.innerText = "<?php echo $data["text"]; ?>";
              selectSelectValue.appendChild(option);
            <?php endforeach; ?>
            break;
          case "class":
            <?php foreach ($selectValueDatas["class1st"] as $data): ?>
              option = document.createElement("option");
              option.value = "<?php echo $data["idx"]; ?>";
              option.innerText = "<?php echo $data["text"]; ?>";
              selectSelectValue.appendChild(option);
            <?php endforeach; ?>
            break;
          case "level":
            <?php for ($i = 0; $i <= 3; $i++): ?>
              option = document.createElement("option");
              option.value = "<?= $i; ?>";
              option.innerText = "<?= $levelTexts[$i]; ?>";
              selectSelectValue.appendChild(option);
            <?php endfor; ?>
            break;
        }
      }

      function Select(element) {
        <?php
          $newQuery = "?";

          if (!empty($queryDatas)) {
            foreach ($queryDatas as $key => $data) {
              if ($key == "page") { continue; }
              if ($key == "select") { continue; }
    
              if (gettype($data) == "string") { $newQuery .= $key . "=" . $data . "&"; }
              else { $newQuery .= $key . "=" . implode("-", $data) . "&"; }
            }
          }

          $url = $route . $newQuery;
        ?>
        let url = "<?= $url; ?>";

        if (selectSelectKey.value == "") {
          url = url.slice(0, -1);
          self.window.location = url;
          return true;
        }
        url += "select=" + selectSelectKey.value + "-";

        if (selectSelectValue.value == "") {
          url = url.slice(0, -1);
          self.window.location = url;
          return true;
        }
        url += selectSelectValue.value + "-";

        if (element == selectSelectValue || selectSelectClass.value == "") {
          url = url.slice(0, -1);
          self.window.location = url;
          return true;
        }
        url += selectSelectClass.value + "-";

        url = url.slice(0, -1);
        self.window.location = url;
        return true;
      }
