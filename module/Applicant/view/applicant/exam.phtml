<script>
function getDayOfWeek(day) {
    const weekdays = ['日', '月', '火', '水', '木', '金', '土'];
    return weekdays[day];
}

function getCurrentDate() {
    const today = new Date();
    const year = today.getFullYear();
    const month = today.getMonth() + 1;
    const date = today.getDate();
    const day = getDayOfWeek(today.getDay());

    return year + '年 ' + addZero(month) + '月 ' + addZero(date) + '日（' + day + '）';
}

function addZero(num) {
    return (num < 10 ? '0' : '') + num;
}

function displayCurrentDate() {
    const dateContainer = document.getElementById('date-container');
    dateContainer.textContent = getCurrentDate();
}

function onLoadEvent() {
	loadPage.click();
}

window.onload = function() {
	onLoadEvent();
  displayCurrentDate();
};

</script>


<script>
  document.getElementById("startBtn").addEventListener("click", function() {
    var lock = 'n';
    var stopBtn = document.getElementById('stopBtn');

    var timerDisplay = document.getElementById("timerDisplay");
    
    var examTime  = <?php echo $time_limit?>; 
    var stopTime = parseInt(10); 

    var minuteToSecond = examTime * 60;
    var stopMinuteToSecond = stopTime * 60;


    var firstAlert= false;
    var secondAlert= false;


    var timer = setInterval(function() {
      if(lock == 'n'){
        updateTimer();
      }
    }, 1000);
    updateTimer();
    
    function updateTimer() {
      var minutes = Math.floor(minuteToSecond / 60);
      var seconds = minuteToSecond % 60;

      timerDisplay.innerHTML ="残り時間: " + minutes + "分 " + seconds + "秒";
      if (minuteToSecond <= 0) {
        clearInterval(timer);
        timerDisplay.innerHTML = "終";
        timeoutExam();
        document.querySelector('.timeout_submit').click();
      }else if(minuteToSecond <= 600 && !firstAlert){
        timerDisplay.style.color = "orange";
        firstAlert=true;
      }else if(minuteToSecond <= 300 && !secondAlert){
        timerDisplay.style.color = "red";
        secondAlert=true;
      }
      else{
        minuteToSecond--;
      }
    }

  document.getElementById("stopBtn").addEventListener("click", function() {
    event.preventDefault();        
    if(lock == 'n'){
      lock='y';
      updateTimer2(); 
      stopBtn.disabled='false';
      stopBtn.style.color = "gray";
    }
    });

    var calc_time=setInterval(function() {
      updateTimer2();
    }, 1000);


  function updateTimer2() {
      if(lock == 'y'){
          var stopMinutes = Math.floor(stopMinuteToSecond / 60);
          var stopSeconds = stopMinuteToSecond % 60;
          document.getElementById("timeLimit").innerHTML="残り時間: " + stopMinutes + "分 " + stopSeconds + "秒";
          stopMinuteToSecond--;

          if (stopMinuteToSecond < 0) {
              clearInterval(calc_time);
              lock = 'y';
              document.getElementById("lock_time").click(); 

              stopBtn.disabled=false; 
              stopBtn.style.color = "gray";
          }
      }
  }


  document.getElementById("lock_time").addEventListener("click",function(){
    if(lock == 'y'){
      lock='n';
    }
  });  
  });


</script>
