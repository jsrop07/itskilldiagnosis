  /* 修正後： */
  function Select() {
    <?php
      $newQuery = "?";

      if (!empty($queryDatas)) {
        foreach ($queryDatas as $key => $data) {
          if ($key == "page") { continue; }
          if ($key == "select") { continue; }

          if (gettype($data) == "string") { $newQuery .= $key . "=" . $data . "&"; }
          else { $newQuery .= $key . "=" . implode("-", $data) . "&"; }
        }
      }

      $url = $route . $newQuery;
    ?>

    let url = "<?= $url; ?>";

    if (selectSelectType.value == "") {
      url = url.slice(0, -1);
      self.window.location = url;
      return true;
    }
    url += "select=" + selectSelectType.value + "-";

    if (selectSelectValue.value == "") {
      url = url.slice(0, -1);
      self.window.location = url;
      return true;
    }
    url += selectSelectValue.value + "-";

    if (selectSelectClass.value == "") {
      url = url.slice(0, -1);
      self.window.location = url;
      return true;
    }
    url += selectSelectClass.value + "-";

    url = url.slice(0, -1);
    self.window.location = url;
    return true;
  }
