}
sendRequest();



function initializeTimers() {
  var examTotalTime = <?php echo $time_limit; ?>;
  var examTotalTimeInSeconds = examTotalTime * 60;
  var examTimeInSeconds = examTime * 60;
  var stopTimeInSeconds = stopTime * 60;

  var firstAlert = false;
  var secondAlert = false;

  var startTime = performance.now();
  var pausedTime = 0;

  function updateTimer() {
    if (lock === 'n') {
      var currentTime = performance.now(); 

      var elapsed = Math.floor((currentTime - startTime - pausedTime) / 1000);
      var remainingTime = examTimeInSeconds - elapsed;
      var minutes = Math.floor(remainingTime / 60);
      var seconds = remainingTime % 60;

      let solveTime = examTotalTimeInSeconds - remainingTime;
      let solveMinutes = Math.floor(solveTime / 60);

      document.getElementById("solveTime").value = solveMinutes ;
      timerDisplay.innerHTML = "残り時間: " + minutes + "分 " + seconds + "秒";

      if (remainingTime <= 0) {
        clearInterval(timer);
        timerDisplay.innerHTML = "終";
        timeoutExam();
        document.querySelector('.timeout_submit').click();
      } else if (remainingTime <= 600 && !firstAlert) {
        timerDisplay.style.color = "orange";
        firstAlert = true;
      } else if (remainingTime <= 300 && !secondAlert) {
        timerDisplay.style.color = "red";
        secondAlert = true;
      }
    }
  }

  var timer = setInterval(updateTimer, 1000);
  updateTimer();

  var stopStartTime;
  var stopTimer;
  
  document.getElementById("stopBtn").addEventListener("click", function(event) {
    event.preventDefault();
    if (lock === 'n') {
      lock = 'y';
      stopStartTime = performance.now();
      stopBtn.disabled = true;
      stopBtn.style.color = "gray";
      PauseTimer();
    }
  });
  PauseTimer();

  function PauseTimer() {
    stopTimer = setInterval(function() {
      if (lock === 'y') {
        var stopElapsed = Math.floor((performance.now() - stopStartTime) / 1000);
        var stopRemainingTime = stopTimeInSeconds - stopElapsed;

        var stopMinutes = Math.floor(stopRemainingTime / 60);
        var stopSeconds = stopRemainingTime % 60;

        document.getElementById("timeLimit").innerHTML = "残り時間: " + stopMinutes + "分 " + stopSeconds + "秒";

        if (stopRemainingTime < 0) {
          clearInterval(stopTimer);
          pausedTime += (performance.now() - stopStartTime);
          lock = 'n';
          document.getElementById("unlock_time").click();

          stopBtn.disabled = false;
          stopBtn.style.color = "gray";
        }
      }
    }, 1000);
  }

  document.getElementById("unlock_time").addEventListener("click", function() {
      if (lock === 'y') {
          lock = 'n';
          pausedTime += (performance.now() - stopStartTime);
      }
  });
}});
</script>
