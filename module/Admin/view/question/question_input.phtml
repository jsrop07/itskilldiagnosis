<script type="text/javascript">
	const numTexts = ["①", "②", "③", "④", "⑤"];
  // [{"code":code, "lang":lang}]
  const langDatas = new Array(
    <?php foreach ($languageCodeDatas as $code => $lang): ?>
      {"code":"<?php echo $code; ?>", "lang":"<?php echo $lang; ?>"},
    <?php endforeach; ?>
  );

  const noticeDivs = document.getElementsByName("div_notice");
	const answerDivs = document.getElementsByName("div_answer");
	const selectInputs = document.getElementsByTagName("select");
	const form = document.getElementById("form");

	let answerCount = <?php echo $answerNum; ?>;
	let answers;

	window.onload = function() {
		answers = [form.answer1, form.answer2, form.answer3, form.answer4, form.answer5];
		SetValue();
    console.log(langDatas);
	}

	function SetValue() {
		<?php if ($isSet): ?>
			for (let i = 0; i < selectInputs.length; i++ ) {
				var select = selectInputs.item(i);
				if (select.value == "") { select.dataset.value = ""; }
				else { select.dataset.value = "1"; }
			}
		<?php else: ?>
			for (let i = 0; i < selectInputs.length; i++ ) {
				var select = selectInputs.item(i);
				if (select.value == "") { select.dataset.value = ""; }
				else { select.dataset.value = "1"; }
			}
		<?php endif; ?>
	}

	function ChangeValue(element) { element.dataset.value = element.value; }

	function ChangeClass1st(element) {
		ChangeValue(element);

		form.class2nd.replaceChildren();
		form.class2nd.dataset.value = "";

		switch (element.value) {
			<?php foreach ($optionDatas["class2nd"] as $value => $class2nd): ?>
				case "<?php echo $value; ?>":
					var option = document.createElement("option");
					option.value = "";
					option.innerText = "選択";
					option.hidden = true;
					form.class2nd.appendChild(option);

					<?php foreach ($class2nd as $data): ?>
						var option = document.createElement("option");
						option.value = <?php echo $data["idx"]; ?>;
						option.innerText = "<?php echo $data["text"]; ?>";
						class2nd.appendChild(option);
					<?php endforeach; ?>
					break;
			<?php endforeach; ?>
		}
	}

	// Change 答え
	function ChangeType(element) {
    if (answerCount == 0) {
      for (let i = 0; i < noticeDivs.length; i++) {
        noticeDivs[i].hidden = true;
      }
    }
		ChangeValue(element);

		let beforeAnswerCount = answerCount;

		text = element[element.selectedIndex].text.trim();
		switch(text) {
			case "3項選択":
				answerCount = 3;
				break;
			case "4項選択":
				answerCount = 4;
				break;
			case "5項選択":
				answerCount = 5;
				break;
		}

		// Show 答え&正解番号
		if (answerCount > beforeAnswerCount) {
			for (let i = beforeAnswerCount; i < answerCount; i++) {
        form.elements["answer" + Number(i + 1)].disabled = false;
        console.log(form.elements["answer" + Number(i + 1)]);
        form.elements["answer" + Number(i + 1)].parentNode.parentNode.hidden = false;

        <?php foreach ($languageCodeDatas as $code => $text): ?>
          form.elements["answer" + Number(i + 1) + "_<?php echo $code; ?>"].disabled = false;
          form.elements["answer" + Number(i + 1) + "_<?php echo $code; ?>"].parentNode.parentNode.hidden = false;
        <?php endforeach; ?>

				var option = document.createElement("option");
				option.value = Number(i + 1);
				option.innerText = numTexts[i];
				form.correct.appendChild(option);
			}
		} else { // Hide 答え&正解番号
			let correctChildren = Array.from(correct.children);
			for (let i = beforeAnswerCount - 1; i >= answerCount; i--) {
        form.elements["answer" + Number(i + 1)].parentNode.parentNode.hidden = true;
        form.elements["answer" + Number(i + 1)].disabled = true;
        form.elements["answer" + Number(i + 1)].value = "";

        <?php foreach ($languageCodeDatas as $code => $text): ?>
          form.elements["answer" + Number(i + 1) + "_<?php echo $code; ?>"].parentNode.parentNode.hidden = true;
          form.elements["answer" + Number(i + 1) + "_<?php echo $code; ?>"].disabled = true;
          form.elements["answer" + Number(i + 1) + "_<?php echo $code; ?>"].value = "";
        <?php endforeach; ?>

				if (form.correct.value == i + 1) {
					form.correct.dataset.value = "";
				}
				correctChildren[i + 1].remove();
			}
		}
	}

	<?php if ($isEdit): ?>
		function Edit() {
			if (ChkValid() == false) { return false; }
      if (confirm("修正しますか？") === false) { return false; }

			const postForm = new FormData(form);
			const xhr = new XMLHttpRequest();
			xhr.open("POST", "../update", true);
			xhr.send(postForm);
			xhr.onload = () => {
				if (xhr.status == 200) {
					const result = xhr.responseText;
          console.log(result);


					if (result == "success") {
						alert("修正しました。");
						self.location.href = "../list";
					}
          else {
            let alertString = ErrorString();
            alertString += "\nresponse text is not success in question_input Edit";
            alertString += "\nresponseText: " + result;
            alert(alertString);

            return false;
          }
				}
        else {
          let alertString = ErrorString();
          alertString += "\nxhr error in question_input Edit";
          alertString += "\nerror code: " + xhr.status;
          alert(alertString);

          return false;
        }
			}
		}
	<?php else: ?>
		function Confirm() {
			if (ChkValid() == false) { return false; }

			form.submit();
		}
	<?php endif; ?>

	function ChkValid() {
		if (form.class1st.value == "") {
			RequestSelect(form.class1st, "大分類");
			return false;
		}

		if (form.class2nd.value == "") {
			RequestSelect(form.class2nd, "小分類");
			return false;
		}

		if (form.level.value == "") {
			RequestSelect(form.level, "レベル");
			return false;
		}

		if (form.type.value == "") {
			RequestSelect(form.type, "問題タイプ");
			return false;
		}

		if (form.title.value.trim() == "") {
			alert("タイトルを入力してください");
			setTimeout("form.title.focus()", 100);
			return false;
		}

		if (form.question.value.trim() == "") {
			alert("問題を入力してください");
			setTimeout("form.question.focus()", 100);
			return false;
		}

		for (let i = 0; i < answerCount; i++) {
      if (form.elements["answer" + Number(i + 1)].disabled == true) { break; }

      if (form.elements["answer" + Number(i + 1)].value.trim() == "") {
        alert("選択肢" + (Number(i) + 1) + "を入力してください");
        setTimeout("form.answer" + (Number(i) + 1) + ".focus()", 100);
        return false;
      }
		}

		if (form.correct.value == "") {
			RequestSelect(form.correct, "正解番号");
			return false;
		}

		if (form.point.value == "") {
			RequestSelect(form.point, "点数");
			return false;
		}

    // check foreign's question, answer input is empty
    let isEmpty = false;
    let emptyLangDatas = new Array();
    for (let i = 0; i < langDatas.length; i++) {
      // check question
      if (form.elements["question_" + langDatas[i]["code"]].value == "") {
        isEmpty = true;
        emptyLangDatas.push(langDatas[i]["lang"]);
        continue;
      }

      for (let j = 0; j < 5; j++) {
        // check answers disabled
        if (form.elements["answer" + Number(j + 1) + "_" + langDatas[i]["code"]].disabled == true) { break; }

        // check answers
        if (form.elements["answer" + Number(j + 1) + "_" + langDatas[i]["code"]].value.trim() == "") {
          isEmpty = true;
          emptyLangDatas.push(langDatas[i]["lang"]);
          break;
        }
      }	
    } 

    if (isEmpty) {
      let emptyLangs = emptyLangDatas.join(",");
      let confirmString = emptyLangs + "問題に未入力項目がありますが、\n";
      confirmString += "このまま登録してもよろしいでしょうか？";
      return confirm(confirmString);
    }
	}

	// For alert
	function RequestSelect(element, text) {
		alert(text + "を選択してください");
		element.focus();
	}



  function ErrorString() {
    let alertString = "予期せぬエラーが発生しました。";
    alertString += "\n管理者にエラー内容をお知らせくださいますようお願いいたします。";
    alertString += "\n\nエラー内容：";
    return alertString;
  }
</script>