            var otherDevelopInput = document.getElementById("otherDevelopInput");
            if (selectedValue == "その他") {
                otherDevelopInput.style.display = "block";
            } else {
                otherDevelopInput.style.display = "none";
            }
        });
</script>

<script>
    function applicationConfirm() {
        // 이메일 입력란의 값 가져오기
        var emailInput = document.querySelector('input[name="email"]');
        var emailValue = emailInput.value.trim();

        // 이메일 입력란이 비어 있는지 확인
        if (emailValue === "") {
            // 이메일 입력란이 비어 있으면 alert 표시
            alert("이메일을 입력하세요!");
            event.preventDefault();

            // 폼 제출 취소
            return false;
        }
    }
</script>