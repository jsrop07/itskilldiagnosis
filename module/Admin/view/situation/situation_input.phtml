<script>
	let skillSelect = document.getElementById('ITskillId');
	let class1stSelect = document.getElementById('class1stId')
  let class1stOtherSelect = document.getElementById('otherclass1st')
	var class2ndSelect = document.getElementById('class2ndId')
	let careerSelect = document.getElementById('careerId')
