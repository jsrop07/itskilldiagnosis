<script>
        document.getElementById("educationSelect").addEventListener("change", function() {
            var selectedValue = this.value;
            var otherEducationInput = document.getElementById("otherEducationInput");
            if (selectedValue == "other") {
                otherEducationInput.style.display = "block";
            } else {
                otherEducationInput.style.display = "none";
            }
        });
</script>

<script>
        document.getElementById("developSelect").addEventListener("change", function() {
