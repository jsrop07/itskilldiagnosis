        const currentExam = document.getElementById('exam' + currentNumber);
        const nextExam = document.getElementById('exam' + (currentNumber + 1));
        if(forms.elements['answer' + currentNumber].value == ""){
          alert("答えを選択してください。")
          ischeck = false;
          return false;
        }
        currentNumber++;
