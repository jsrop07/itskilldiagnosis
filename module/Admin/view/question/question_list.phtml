    <script>
      const selectType = document.getElementById("select-type");
      const selectValue = document.getElementById("select-value");
      const selectClass = document.getElementById("select-class");

      function ChangeSelectOption(element) {
        let value = element.value;
        if (value == "") { Select(element); }
        
        selectClass.replaceChildren();
        var option = document.createElement("option");
        option.hidden = true;
        option.innerText = "選択";
        selectClass.appendChild(option);

        selectValue.replaceChildren();
        option = document.createElement("option");
        option.hidden = true;
        option.innerText = "選択";
        selectValue.appendChild(option);

        switch(value) {
          case "status":
            <?php foreach ($selectValueDatas["status"] as $data): ?>
              option = document.createElement("option");
              option.value = "<?php echo $data["idx"]; ?>";
              option.innerText = "<?php echo $data["text"]; ?>";
              selectValue.appendChild(option);
            <?php endforeach; ?>
            break;
          case "class":
            <?php foreach ($selectValueDatas["class1st"] as $data): ?>
              option = document.createElement("option");
              option.value = "<?php echo $data["idx"]; ?>";
              option.innerText = "<?php echo $data["text"]; ?>";
              selectValue.appendChild(option);
            <?php endforeach; ?>
            break;
          case "level":
            <?php for ($i = 0; $i <= 3; $i++): ?>
              option = document.createElement("option");
              option.value = "<?= $i; ?>";
              option.innerText = "<?= $levelTexts[$i]; ?>";
              selectValue.appendChild(option);
            <?php endfor; ?>
            break;
        }
      }

      function Select(element) {
        let value = element.value
        if (selectType.value == "class" && element != selectClass) {
          ChangeClassOption(value);
          return false;
        }

        <?php
          $newQuery = "?";

          if (!empty($queryDatas)) {
            foreach ($queryDatas as $data) {
              if (explode("=", $data)[0] == "page") { continue; }
              if (explode("=", $data)[0] == "select") { continue; }

              $newQuery .= $data . "&";
            }
          }

          $url = $route . $newQuery;
        ?>

        let url = "<?= $url; ?>";

        if (selectType.value == "class") {
          url += "select=" + selectType.value + "-" + selectValue.value + "-" + value + "&";
        }
        else {
          if (value != "") { url += "select=" + selectType.value + "-" + value + "&"; }
        }
        url = url.slice(0, -1);

        self.window.location = url;
      }

      function ChangeClassOption(value) {
        console.log(value);
        selectClass.replaceChildren();

        var option = document.createElement("option");
        option.hidden = true;
        option.innerText = "選択";
