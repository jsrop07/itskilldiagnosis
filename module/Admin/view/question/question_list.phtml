  /** check delete authority
   * @param array $data questionData
   * @param array $optionDatas ["idx" => "text"]
	 * @return bool
  */
  function ChkDeleter($data, $optionDatas) {
    if ($optionDatas[$data["status"]] == "新規") { return true; }
    return false;
  }

  if (!isset($_SESSION)) { session_start(); }
  $url = explode("?", $_SERVER["REQUEST_URI"]);
  $route = $url[0];

  $isSearch = array(
    "select" => false,
    "title" => false,
  );

  $queryDatas = array();
  if (isset($url[1])) {
    $querys = explode("&", $url[1]);
    foreach ($querys as $query) {
      $queryData = explode("=", $query);

      if ($queryData[0] == "page") { continue; }

      if ($queryData[0] == "select") {
        $queryDatas["select"] = explode("-", $queryData[1]);
        $isSearch["select"] = true;
      }
      else {
        $queryDatas[$queryData[0]] = $queryData[1];
        $isSearch[$queryData[0]] = true;
      }
    }
  }

  $firstNo = $questionDatas->getTotalItemCount();
  $firstNo -= (($questionDatas->getCurrentPageNumber() - 1) * $questionDatas->getitemCountPerPage());

  // check select
  $isSelect = false;
  if (isset($searchDatas["select"])) { $isSelect = true; }

  // check authority
  $isApprover = false;
  if ($_SESSION["user"]["level"] >= 1) { $isApprover = true; }
