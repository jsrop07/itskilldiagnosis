<?php
	$numTexts = array("①", "②", "③", "④", "⑤");

	if (!isset($_SESSION)) { session_start(); }
	$userCode = $_SESSION["user"]["code"] ;

	// Check approve authority
	$isApprover = false;
	if ($_SESSION["user"]["level"] >= 1) { $isApprover = true; }

	// Check is user register
	$isRegister = false;
	if ($userCode == $questionData["admin_regist"]) { $isRegister = true; }
?>

<?php echo $this->partial("breadcrumb", ["datas" => $breadcrumbData]); ?>

<h1 class="title">問題詳細</h1>

<div class="emegra card">
	<div class="card-header">設定</div>

	<div class="card-body">
		<style type="text/css">
			dl.emegra.setting { grid-template-columns: repeat(2, 90px 1fr); }
		</style>
		<dl class="emegra setting">
			<dt>分類</dt>
			<dd><?php echo $optionDatas[$questionData["class1st"]] . " / " . $optionDatas[$questionData["class2nd"]]; ?></dd>

			<dt>レベル</dt>
			<dd><?php echo $optionDatas[$questionData["level"]]; ?></dd>

			<dt>問題タイプ</dt>
			<dd style="grid-column: 2 / 5;"><?php echo $optionDatas[$questionData["type"]]; ?></dd>

			<dt>タイトル</dt>
			<dd style="grid-column: 2 / 5;"><?php echo $questionData["title"]; ?></dd>
		</dl>
	</div>
</div>

<div class="emegra card" style="margin-top: 32px;">
	<div class="card-header">問題</div>

	<div class="card-body">
		<style type="text/css">
			dl.emegra.question { grid-template-columns: 90px 1fr; }
		</style>
		<dl class="emegra question">
			<dt>問題</dt>
			<dd><?php echo $questionData["question"]; ?></dd>

			<dt>答え</dt>
			<dd class="expand">
				<?php foreach (explode(",", $questionData["answers"]) as $index => $answer): ?>
					<?= $numTexts[$index]; ?>
					<?php echo $answer; ?> </br>
				<?php endforeach; ?>
			</dd>

			<dt>正解番号</dt>
			<dd><?php echo $questionData["correct"]; ?></dd>

			<dt>点数</dt>
			<dd><?php echo $questionData["point"]; ?></dd>
		</dl>
	</div>
</div>

<div class="emegra card" style="margin-top: 32px;">
	<div class="card-header">情報</div>

	<div class="card-body">
		<style type="text/css">
			dl.emegra.info { grid-template-columns: repeat(2, 90px 1fr); }
		</style>
		<dl class="emegra info">
			<dt>作成者</dt>
			<dd><?php echo $register; ?></dd>

			<dt>作成日</dt>
			<dd><?php echo date("y/m/d", strtotime($questionData["date_regist"])); ?></dd>

			<dt>承認者</dt>
			<dd><?php echo ($questionData["admin_approve"] != null) ? $approver : "未承認"; ?></dd>

			<dt>承認日</dt>
			<dd><?php echo isset($questionData["date_approve"]) ? date("y/m/d", strtotime($questionData["date_approve"])) : "未承認"; ?></dd>

			<dt>備考</dt>
			<dd class="expand" style="grid-column: 2 / 5;"><?php echo $note; ?></dd>
		</dl>
	</div>
</div>

<div class="btn-place" style="margin-top: 32px;">
	<button class="emegra cancel" onclick="self.location.href='../list';">戻る</button>
	<?php if ($isApprover && $questionData["admin_approve"] == null): ?>
		<button class="emegra" onclick="Approve();">承認</button>
	<?php endif; ?>
	<?php if ($isApprover || ($isRegister && $questionData["admin_approve"] == null)): ?>
		<button class="emegra delete" onclick="Delete();">削除</button>
		<button class="emegra" onclick="self.location.href='../edit/<?php echo $questionData['idx']; ?>';">修正</button>
	<?php endif; ?>
</div>

<script type="text/javascript">
	<?php if ($isApprover && $questionData["admin_approve"] == null): ?>
		function Approve() {
			const postForm = new FormData();
			postForm.append("idxs", <?php echo $questionData["idx"]; ?>);

			const xhr = new XMLHttpRequest();
			xhr.open("POST", "../approve", true);
			xhr.send(postForm);
			xhr.onload = () => {
				if (xhr.status == 200) {
					const result = xhr.responseText;
					if (result == "success") {
						alert("承認しました。");
						location.reload(true);
					}
					else {
						alert("Error");
						console.log(result);
					}
				}
			}
		}
	<?php endif; ?>

	<?php if ($isApprover || ($isRegister && $questionData["admin_approve"] == null)): ?>
		function Delete() {
			const postForm = new FormData();
			postForm.append("idxs", <?php echo $questionData["idx"]; ?>);

			const xhr = new XMLHttpRequest();
			xhr.open("POST", "../delete", true);
			xhr.send(postForm);
			xhr.onload = () => {
				if (xhr.status == 200) {
					const result = xhr.responseText;
					if (result == "success") {
						alert("削除しました。");
						self.location.href = "../list";
					}
					else {
						alert("Error");
						console.log(result);
					}
				}
			}
		}
	<?php endif; ?>
</script>