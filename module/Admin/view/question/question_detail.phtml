	$userCode = $_SESSION["user"]["code"] ;
	
	$isRegister = false;
	if ($_SESSION["user"]["level"] >= 2) { $isRegister = true; }
	if ($userCode == $questionData["admin_regist"] && $questionData["date_regist"] == null) {
		$isRegister = true;
	}

	$isDeleter = false;
	if ($_SESSION["user"]["level"] >= 3 || ($questionData["admin_create"] == $userCode || $questionData["admin_regist"] == $userCode)) {
		$isDeleter = true;
	}
?>

