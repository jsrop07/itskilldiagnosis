      class2ndSelect.appendChild(noSkillClass2ndoption);
      class2ndSelect.value = "33";
      careerSelect.value="0";
      class1stSelect.setAttribute('disabled', 'disabled');
      class2ndSelect.setAttribute('disabled', 'disabled');
      class1stOtherSelect.setAttribute('disabled', 'disabled');
      careerSelect.setAttribute('disabled', 'disabled');
      class1stOtherSelect.style.display = "none";
      hiddenClass1st.value = "その他";
      hiddenClass2nd.value = "33";
      hiddenCareer.value = "0";
    }
    else{
      class1stSelect.value = "";
      class1stOtherSelect.value="";
      class1stOtherSelect.style.display = "block";
      class2ndSelect.innerText="";
      careerSelect.value = "";
