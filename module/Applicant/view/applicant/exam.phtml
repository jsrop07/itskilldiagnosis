<script>
function getDayOfWeek(day) {
    const weekdays = ['日', '月', '火', '水', '木', '金', '土'];
    return weekdays[day];
}

function getCurrentDate() {
    const today = new Date();
    const year = today.getFullYear();
    const month = today.getMonth() + 1;
    const date = today.getDate();
    const day = getDayOfWeek(today.getDay());

    return year + '年 ' + addZero(month) + '月 ' + addZero(date) + '日（' + day + '）';
}

function addZero(num) {
    return (num < 10 ? '0' : '') + num;
}

function displayCurrentDate() {
    const dateContainer = document.getElementById('date-container');
    dateContainer.textContent = getCurrentDate();
}

function onLoadEvent() {
	loadPage.click();
}

window.onload = function() {
	onLoadEvent();
  displayCurrentDate();
};

</script>
<script>
  function executeTime() {
  const url = window.location.href;
  const postForm = new FormData();
  const examIdx = <?= json_encode($examIdx) ?>;
  postForm.append("idx", examIdx);

  const xhr = new XMLHttpRequest();
  xhr.open("POST", url, true);
  xhr.send(postForm);
  xhr.onload = () => {
    if (xhr.status == 200) {
        try {
            const result = JSON.parse(xhr.responseText);
            if (result === "wrong") {
            return;
            }
          } catch (e) {
            console.error("Failed to parse response", e);
            alert("診断開始サーバー分析に失敗しました。担当者にお問い合わせください。");
        }
    }
}
}
</script>
