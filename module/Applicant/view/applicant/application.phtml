<!-- ITスキル有無選択時に画面変化 -->
<script>
var skillSelect = document.querySelector('select[name="skill"]');

var class2ndSelect = document.getElementById('typeSelect');
var class2ndSpanSelect = document.getElementById('spanTypeSelect');

var Applicantclass1stSelect = document.getElementById('class1stSelect');
var Applicantclass1stSpanSelect=document.getElementById('spanclass1stSelect');

var otherclass1stInput = document.getElementById('otherclass1stInput');

var careerInput = document.getElementById('career');
var ApplicantCareerInput = document.getElementById('spanCareer');

var certificatesInput = document.querySelector('input[name="certificates"]');
var ApplicantCertificatesInput = document.getElementById('spanCertificates');


var otherTextarea = document.querySelector('textarea[name="other"]');
var ApplicantOtherTextarea = document.getElementById('spanOther');


skillSelect.addEventListener('change', function() {
    var selectedValue = this.value;
    if (selectedValue === '1') {
        class2ndSelect.style.display='none';        
        class2ndSpanSelect.style.display='none';

        Applicantclass1stSelect.style.display='none';
        Applicantclass1stSpanSelect.style.display='none';
        otherclass1stInput.style.display='none';

        careerInput.style.display='none';
        ApplicantCareerInput.style.display='none';
        
        certificatesInput.style.display='none';
        ApplicantCertificatesInput.style.display='none';


        class2ndSelect.disabled=true;
        class1stSelect.disabled = true;
        otherclass1stInput.querySelector('input').disabled = true;
        careerInput.disabled = true;
        certificatesInput.disabled = true;
    } else {
        class2ndSelect.style.display='block';    
        class2ndSpanSelect.style.display='block'; 

        Applicantclass1stSelect.style.display='block';
        Applicantclass1stSpanSelect.style.display='block';
        otherclass1stInput.style.display='block';
        otherclass1stInput.style.display='none';

        careerInput.style.display='block';
        ApplicantCareerInput.style.display='block';

        certificatesInput.style.display='block';
        ApplicantCertificatesInput.style.display='block';


        class2ndSelect.disabled=false;
        class1stSelect.disabled = false;
        otherclass1stInput.querySelector('input').disabled = false;
        careerInput.disabled = false;
        certificatesInput.disabled = false;
    }
    
});
</script>

