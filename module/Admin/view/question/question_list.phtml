<script type="text/javascript">
	const input_register = document.getElementById("input_register");
	const div_search = document.getElementById("div_search");
	let searchData = "status";
	const check_all = document.getElementById("checkAll");
	const check_idxs = document.getElementsByName("checkIdx");

	function Checking(element) {
		if (element == check_all) {
			if (element.checked) {
				check_idxs.forEach(e => { e.checked = true; })
			}
			else {
				check_idxs.forEach(e => { e.checked = false; })
			}
		}

		if (element != check_all) {
			check_all.checked = false;

			check_idxs.forEach(e => {
				if (e.checked) { check_all.checked = true; return true; }
			});
		}
	}

	function SearchRegister() {
		let urlText = "?";

		let register = input_register.value;
		if (register.trim() != "") { urlText += "register=" + register + "&"; }

		let option = document.getElementById("search-" + searchData);
		option = option.options[option.selectedIndex].value;
		if (option != "") { urlText += searchData + "=" + option + "&"; }

		urlText = urlText.slice(0, -1);
		self.window.location = window.location.pathname + urlText;
	}

	function ChangeSearch(value) {
		searchData = value;

		let searchElement;
		switch(value) {
			case "point":
				searchElement = document.createElement("select");
				searchElement.classList.add("form-select");
				searchElement.classList.add("form-select-sm");
				searchElement.style.width = "150px";
				searchElement.name = "search";
				searchElement.id = "search-point";

				var option = document.createElement("option");
				option.value = "";
				option.innerText = "未設定";
				searchElement.appendChild(option);

				for (let i = 0; i < 5; i++) {
					var option = document.createElement("option");
					option.value = i;
					option.innerText = i + 1;
					searchElement.appendChild(option);

				}
				break;

			case "title":
				searchElement = document.createElement("input");
				searchElement.classList.add("form-control");
				searchElement.classList.add("form-control-sm");
				searchElement.style.width = "150px";
				searchElement.name = "search";
				searchElement.id = "search-title";
				break;
			<?php foreach ($optionDatas as $option): ?>
				case "<?php echo $option; ?>":
					searchElement = document.createElement("select");
					searchElement.classList.add("form-select");
					searchElement.classList.add("form-select-sm");
					searchElement.style.width = "150px";
					searchElement.name = "search";
					searchElement.id = "search-<?php echo $option; ?>";

					var option = document.createElement("option");
					option.value = "";
					option.innerText = "未設定";
					searchElement.appendChild(option);

					<?php foreach (${$option . "Datas"} as $i => $data): ?>
						var option = document.createElement("option");
						option.value = <?= $i; ?>;
						option.innerText = "<?php echo $data; ?>";
						searchElement.appendChild(option);

					<?php endforeach; ?>
					break;

			<?php endforeach; ?>
		}
		
		div_search.children[0].remove();
		div_search.appendChild(searchElement);
	}

	function Align(element) {
		<?php
			$url = $_SERVER["REQUEST_URI"];
			$url = $url . "?";
			$query = explode("?", $url)[1];
	
			if (!empty($query)) {
				$queryDatas = explode("&", $query);

				$newQueryDatas = array();
				foreach ($queryDatas as $data) {
					if (explode("=", $data)[0] != "align") {
						array_push($newQueryDatas, $data);
					}
				}
				$newQuery = implode("&", $newQueryDatas);
				$url = explode("?", $_SERVER["REQUEST_URI"])[0] . "?" . $newQuery . "&";
			}
		?>

		let alignValue = element.id;
		if (element.innerText.includes("▲")) {
			alignValue += "_DESC";
		}
		
		if (element.innerText.includes("▼")) { self.location.href = "<?php echo substr($url, 0, -1); ?>"; }
		else { self.location.href = "<?php echo $url; ?>" + "align=" + alignValue; }
	}
</script>
