  var hiddenClass2nd= document.getElementById('noSkillClass2nd');
  var hiddenCareer= document.getElementById('noSkillCareer');
  var noSkillClass2ndoption = document.createElement("option");
  var yesSkillClass2ndoption = document.createElement("option");

  function SkillSelectChange(value){
  form.skill.value = value;
    if (form.skill.value === '1') {
      class1stSelect.value="その他";
      class2ndSelect.innerText="";
      noSkillClass2ndoption.value = "33";
