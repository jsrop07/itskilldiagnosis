<script type="text/javascript">
	const input_register = document.getElementById("input_register");
	const input_title = document.getElementById("input_title");
	const div_search = document.getElementById("div_search");
	const check_all = document.getElementById("checkAll");
	const check_idxs = document.getElementsByName("checkIdx");

	let searchData = "status";

	function Checking(element) {
		if (element == check_all) {
			if (element.checked) {
				check_idxs.forEach(e => {
					if (!e.disabled) { e.checked = true; }
				});
			}
			else {
				check_idxs.forEach(e => { e.checked = false; });
			}
		}

		if (element != check_all) {
			check_all.checked = false;

			check_idxs.forEach(e => {
				if (e.checked) { check_all.checked = true; return true; }
			});
		}
	}

	function SearchRegister() {
		<?php
			if (!empty($query)) {
				$queryDatas = explode("&", $query);
				
				$newQueryDatas = array();
				foreach ($queryDatas as $data) {
					$key = explode("=", $data)[0];
					if ($key != "page" && $key != "register") {
						array_push($newQueryDatas, $data);
					}
				}

				$newQuery = implode("&", $newQueryDatas);
				$url = explode("?", $_SERVER["REQUEST_URI"])[0] . "?" . $newQuery;
				if (!empty($newQuery)) { $url .= "&"; }
			}
		?>

		let url = "<?= $url; ?>";
		
		let register = input_register.value;
		if (register.trim() != "") { url += "register=" + register; }
		else { url = url.slice(0, -1); }

		self.window.location = url;
	}

	function SearchTitle() {
		<?php
			if (!empty($query)) {
				$queryDatas = explode("&", $query);
				
				$newQueryDatas = array();
				foreach ($queryDatas as $data) {
					$key = explode("=", $data)[0];
					if ($key != "page" && $key != "title") {
						array_push($newQueryDatas, $data);
					}
				}

				$newQuery = implode("&", $newQueryDatas);
				$url = explode("?", $_SERVER["REQUEST_URI"])[0] . "?" . $newQuery;
				if (!empty($newQuery)) { $url .= "&"; }
			}
		?>

		let url = "<?= $url; ?>";
		
		let title = input_title.value;
		if (title.trim() != "") { url += "title=" + title; }
		else { url = url.slice(0, -1); }

		self.window.location = url;
	}

	function ChangeSearch(value) {
		<?php
			if (!empty($query)) {
				$queryDatas = explode("&", $query);
				
				$newQueryDatas = array();
				foreach ($queryDatas as $data) {
					$key = explode("=", $data)[0];
					if ($key != "align") {
						array_push($newQueryDatas, $data);
					}
				}

				$newQuery = implode("&", $newQueryDatas);
				$url = explode("?", $_SERVER["REQUEST_URI"])[0] . "?" . $newQuery;
				if (!empty($newQuery)) { $url .= "&"; }
			}
		?>

		let url = "<?= $url; ?>";
		
		let align = value;
		url += "align=" + align;

		self.window.location = url;
	}

	function Regist() {
		let idxDatas = "";

		check_idxs.forEach(e => {
			if (e.checked) {
				idxDatas += e.value + ",";
			}
		});

		let chk = true;
		const postForm = new FormData();
		postForm.append("idxs", idxDatas.slice(0, -1));

		const xhr = new XMLHttpRequest();
		xhr.open("POST", "./approve", true);
		xhr.send(postForm);
		xhr.onload = () => {
			if (xhr.status == 200) {
				const result = xhr.responseText;

				if (result == "success") {
					alert("承認しました。");
					location.reload(true);
				}
				else if (result == "fail") { alert("承認できたデータがあります。"); }
				else {
					alert("Error");
					console.log($result);
				}
			}
		}
	}

	function Delete() {
		let idxDatas = "";

		check_idxs.forEach(e => {
			if (e.checked) {
				idxDatas += e.value + ",";
			}
		});

		idxDatas.slice(0, -1);

		const postForm = new FormData();
		postForm.append("idxs", idxDatas.slice(0, -1));

		const xhr = new XMLHttpRequest();
		xhr.open("POST", "./delete", true);
		xhr.send(postForm);

		xhr.onload = () => {
			if (xhr.status == 200) {
				const result = xhr.responseText;
				if (result == "success") {
					alert("削除しました。");
					location.reload(true);
				}
				else {
					alert("Error");
					console.log($result);
				}
			}
		}
	}
</script>
