<script type="text/javascript">
  const input_approver = document.getElementById("input_approver");
  const input_title = document.getElementById("input_title");
  const div_search = document.getElementById("div_search");
  const check_all = document.getElementById("checkAll");
  const checkElements = document.getElementsByName("checkIdx");

  let searchData = "status";

  /*
    作成：朴昰成
    作成日：24/06/12
  */
	window.onpageshow = function(event) {
    if(event.persisted || (window.performance && window.performance.navigation.type == 2)) {
      check_all.checked = false;
      for (let i = 0; i < checkElements.length; i++) {
        checkElements[i].checked = false;
      }
    }
  }

  /* ここまで */
  function Checking(element) {
    if (element == check_all) {
      for (let i = 0; i < checkElements.length; i++) {
        if (!checkElements[i].disabled) {
          checkElements[i].checked = element.checked;
        }
      }
    }
    else {
      let allChecked = true;
      for (let i = 0; i < checkElements.length; i++) {
        if (checkElements[i].checked == false) {
          if (checkElements[i].disabled == true) { continue; }
          allChecked = false;
          break;
        }
      }

      check_all.checked = allChecked;
    }
  }

  function SearchRegister() {
    <?php
      $newQuery = "?";

      if (!empty($queryDatas)) {
        foreach ($queryDatas as $data) {
          if (explode("=", $data)[0] == "approver") { continue; }

          $newQuery .= $data . "&";
        }
      }

      $url = $route . $newQuery;
    ?>

    let url = "<?= $url; ?>";

    let approver = input_approver.value;
    if (approver.trim() != "") { url += "approver=" + approver + "&"; }
    url = url.slice(0, -1);

    self.window.location = url;
  }

  function SearchTitle() {
    <?php
      $newQuery = "?";

      if (!empty($queryDatas)) {
        foreach ($queryDatas as $data) {
          if (explode("=", $data)[0] == "title") { continue; }

          $newQuery .= $data . "&";
        }
      }

      $url = $route . $newQuery;
    ?>

    let url = "<?= $url; ?>";

    let title = input_title.value;
    if (title.trim() != "") { url += "title=" + title + "&"; }
    url = url.slice(0, -1);

    self.window.location = url;
  }

  function ChangeSearch(value) {
    <?php
      $newQuery = "?";

      if (!empty($queryDatas)) {
        foreach ($queryDatas as $data) {
          if (explode("=", $data)[0] == "page") { continue; }
          if (explode("=", $data)[0] == "align") { continue; }

          $newQuery .= $data . "&";
        }
      }

      $url = $route . $newQuery;
    ?>

    let url = "<?= $url; ?>";

    url += "align=" + value + "&";
    url = url.slice(0, -1);

    self.window.location = url;
  }

  function Approve() {
    let idxs = "";
    for (let i = 0; i < checkElements.length; i++) {
      if (checkElements[i].checked) {
        idxs += checkElements[i].value + ",";
      }
    }

    if (idxs == "") {
      alert("承認する問項を選択してください。");
      return false;
    }

    if (confirm("承認しますか？") === false) { return false; }

    const postForm = new FormData();
    postForm.append("idxs", idxs.slice(0, -1));

    const xhr = new XMLHttpRequest();
    xhr.open("POST", "approve", true);
    xhr.send(postForm);
    xhr.onload = () => {
      if (xhr.status == 200) {
        const result = xhr.responseText;

        if (result == "success") {
          alert("承認しました。");
          location.reload(true);
        }
        else {
          try {
            error = JSON.parse(result);

            switch (error["reason"]) {
              case "approved":
                let alertString = "承認できなかった問項があります。\n\n"
                alertString += "承認できなかった問項";

                let questionIdxDatas = error["data"];
                for (let i = 0; i < questionIdxDatas.length; i++) {
                  for (let j = 0; j < checkElements.length; j++) {
                    if (questionIdxDatas[i] == checkElements[j].value) {
                      alertString += "\n" + checkElements[j].parentNode.parentNode.children[0].innerText + "．" + checkElements[j].parentNode.parentNode.children[5].innerText;
                    }
                  }
                }

                alert(alertString);
                return false;
            }
            alert("error");
            console.log(result);
            return false;
          }
          catch (e) {
            alert("error");
            console.log(result);
            return false;
          }
        }
      }
    }
  }

  function Remove() {
    let idxs = "";
    for (let i = 0; i < checkElements.length; i++) {
      if (checkElements[i].checked) {
        idxs += checkElements[i].value + ",";
      }
    }

    if (idxs == "") {
      alert("削除する問項を選択してください。");
      return false;
    }

    if (confirm("削除しますか？") === false) { return false; }

    const postForm = new FormData();
    postForm.append("idxs", idxs.slice(0, -1));

    const xhr = new XMLHttpRequest();
    xhr.open("POST", "remove", true);
    xhr.send(postForm);
    xhr.onload = () => {
      if (xhr.status == 200) {
        const result = xhr.responseText;
        if (result == "success") {
          alert("削除しました。");
          location.reload(true);
        }
        else {
          alert("Error");
          console.log($result);
        }
      }
    }
  }
</script>
