		// 	if (xhr.status == 200) {
		// 		const result = xhr.responseText;
		// 		if (result == "success") {
		// 			alert("承認しました。");
		// 			location.reload(true);
		// 		}
		// 		else {
		// 			alert("Error");
		// 			console.log($result);
		// 		}
		// 	}
		// }
	}

	function Delete() {
		let idxDatas = "";

		check_idxs.forEach(e => {
			if (e.checked) {
				idxDatas += e.value + ",";
			}
		});

		idxDatas.slice(0, -1);

		const postForm = new FormData();
		postForm.append("idxs", idxDatas.slice(0, -1));

		const xhr = new XMLHttpRequest();
		xhr.open("POST", "./delete", true);
		xhr.send(postForm);

		xhr.onload = () => {
			if (xhr.status == 200) {
				const result = xhr.responseText;
				if (result == "success") {
					alert("削除しました。");
					location.reload(true);
				}
				else {
					alert("Error");
					console.log($result);
				}
			}
		}
	}
</script>
