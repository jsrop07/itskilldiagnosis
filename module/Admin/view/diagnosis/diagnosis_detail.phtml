  function ChangeToPopoverForm($string) {
    $string = str_replace("<", "＜", $string);
    $string = str_replace(">", "＞", $string);
    $string = str_replace('"', "”", $string);
    $string = str_replace("{{n}}", "<br/>", $string);
    $string = "<pre>" . $string . "</pre>";
    return $string;
  }

  if (!isset($_SESSION)) { session_start(); }

  $resultPointDatas = explode(",", $diagnosisData["result_points"]);
  $resultTextDatas = explode(",", $diagnosisData["result_texts"]);
  $resultCommentDatas = explode(",", $diagnosisData["result_comments"]);

