<script type="text/javascript">
	const selectSearch = document.getElementById("select-search");

	let searchOption = "<?php echo (isset($searchData)) ? $searchKey : "status"; ?>";

	function ChangeSearch(value) {
		selectSearch.replaceChildren();
		searchOption = value;

		var option = document.createElement("option");
		option.value = "";
		option.innerText = "選択";
		option.hidden = true;
		selectSearch.appendChild(option);

		switch(value) {
			case "level":
				<?php foreach ($optionDatas["level"] as $data): ?>
					var option = document.createElement("option");
					option.value = <?php echo $data["idx"]; ?>;
					option.innerText = "<?php echo $data["text"]; ?>";
					selectSearch.appendChild(option);
				<?php endforeach; ?>
				break;
			case "class1st":
				<?php foreach ($optionDatas["class1st"] as $data): ?>
					var option = document.createElement("option");
					option.value = <?php echo $data["idx"]; ?>;
					option.innerText = "<?php echo $data["text"]; ?>";
					selectSearch.appendChild(option);
				<?php endforeach; ?>
				break;
			case "class2nd":
				<?php foreach ($optionDatas["class2nd"] as $data): ?>
					var option = document.createElement("option");
					option.value = <?php echo $data["idx"]; ?>;
					option.innerText = "<?php echo $data["text"]; ?>";
					selectSearch.appendChild(option);
				<?php endforeach; ?>
				break;
			case "case":
				<?php foreach ($optionDatas["case"] as $data): ?>
					var option = document.createElement("option");
					option.value = <?php echo $data["idx"]; ?>;
					option.innerText = "<?php echo $data["text"]; ?>";
					selectSearch.appendChild(option);
				<?php endforeach; ?>
				break;
		}
	}

	function SearchDiagnosis() {
		if (selectSearch.value == "") {
			alert("検索するデータを選択してください。");
			selectSearch.focus();
			return false;
		}
		
		let url = "<?= $url ?>?" + searchOption + "=" + selectSearch.value;
		self.window.location = url;
	}
</script>