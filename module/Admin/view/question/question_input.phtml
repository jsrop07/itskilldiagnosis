<script type="text/javascript">
	const numTexts = ["①", "②", "③", "④", "⑤"];

	const class2nd = document.getElementById("class2nd");
	const type = document.getElementById("type");
	const answers = document.getElementById("answers");
	const correct = document.getElementById("correct");
	const dateRegist = document.getElementById("date_regist");
	const form = document.getElementById("form");
	const selectboxElements = document.getElementsByTagName("select");

	let datetime = "";
	let answerCount = <?php echo $answerNum; ?>;

	// Get datetime data
	window.onload = function() {
		const now = new Date();
		datetime = now.toISOString().replace("T", " ").substring(0, 19);
		SetValue();
	}

	function SetValue() {
		<?php if ($isReturn): ?>
			for (let i = 0; i < selectboxElements.length; i++ ) {
				var select = selectboxElements.item(i);
				if (select.value == "") { select.dataset.value = ""; }
				else { select.dataset.value = "1"; }
			}
		<?php else: ?>
			for (let i = 0; i < selectboxElements.length; i++ ) {
				var select = selectboxElements.item(i);
				if (select.value == "") { select.dataset.value = ""; }
				else { select.dataset.value = "1"; }
			}
		<?php endif; ?>
	}

	function ChangeValue(element) { element.dataset.value = element.value; }

	function ChangeClass1st(element) {
		ChangeValue(element);

		class2nd.replaceChildren();
		
		switch (element.value) {
			<?php foreach ($optionDatas["class2nd"] as $value => $class2nd): ?>
				case "<?php echo $value; ?>":
					var option = document.createElement("option");
					option.value = "";
					option.innerText = "選択";
					option.hidden = true;
					class2nd.appendChild(option);

					<?php foreach ($class2nd as $data): ?>
						var option = document.createElement("option");
						option.value = <?php echo $data["idx"]; ?>;
						option.innerText = "<?php echo $data["text"]; ?>";
						class2nd.appendChild(option);
					<?php endforeach; ?>
					break;
			<?php endforeach; ?>
		}
	}

	// Change 答え
	function ChangeType(element) {
		if (answerCount == 0) { answers.replaceChildren(); }
		ChangeValue(element);

		let beforeAnswerCount = answerCount;

		text = element[element.selectedIndex].text.trim();
		switch(text) {
			case "3項選択":
				answerCount = 3;
				break;
			case "4項選択":
				answerCount = 4;
				break;
			case "5項選択":
				answerCount = 5;
				break;
		}

		// Delete 答え&正解番号
		if (answerCount < beforeAnswerCount) {
			answerElements = Array.from(answers.children);
			correctElements = Array.from(correct.children);

			for (let i = beforeAnswerCount; i > answerCount; i--) {
				for (let j = 0; j < 2; j++) {
					var answerE = answerElements[((i - 1) * 2) - j];
					answerE.remove();
				}

				if (correct.selectedIndex == i) { correct.dataset.value = ""; }
				var correctE = correctElements[i];
				correctE.remove();
			}
		} else {
			// Create 答え&正解番号 option
			for (let i = beforeAnswerCount; i < answerCount; i++) {
				var dt = document.createElement("dt");
				dt.classList.add("essential");
				dt.innerText = numTexts[i];
				answers.appendChild(dt);

				var dd = document.createElement("dd");
				var input = document.createElement("input");
				input.classList.add("form-control");
				input.name = "answer" + Number(i + 1);
				input.type = "text";
				dd.appendChild(input);
				answers.appendChild(dd);

				var option = document.createElement("option");
				option.value = Number(i) + 1;
				option.innerText = numTexts[i];
				correct.appendChild(option);
			}
		}
	}

	function Confirm() {
		if (form.class1st.value == "") {
			RequestSelect(form.class1st, "大分類");
			return false;
		}

		if (form.class2nd.value == "") {
			RequestSelect(form.class2nd, "小分類");
			return false;
		}

		if (form.level.value == "") {
			RequestSelect(form.level, "レベル");
			return false;
		}

		if (form.type.value == "") {
			RequestSelect(form.type, "問題タイプ");
			return false;
		}

		if (form.title.value.trim() == "") {
			alert("タイトルを入力してください");
			setTimeout("form.title.focus()", 100);
			return false;
		}

		if (form.question.value.trim() == "") {
			alert("問題を入力してください");
			setTimeout("form.question.focus()", 100);
			return false;
		}

		for (let i = 1; i <= answerCount; i++) {
			var element = document.getElementsByName("answer" + i)[0];

			if (element.value.trim() == "") {
				alert("答え" + (Number(i) + 1) + "を入力してください");
				setTimeout("form.answer" + i + ".focus()", 100);
				return false;
			}
		}

		if (form.correct.value == "") {
			RequestSelect(form.correct, "正解番号");
			return false;
		}

		if (form.point.value == "") {
			RequestSelect(form.point, "点数");
			return false;
		}

		// Change 作成日 data
		dateRegist.type = "text";
		dateRegist.value = datetime;

		form.submit();
	}

	// For alert
	function RequestSelect(element, text) {
		alert(text + "を選択してください");
		element.focus();
	}
</script>