  function ChangeClass2nd(element) {
    let selectbox = form.class2nd;
    selectbox.replaceChildren();

    var option = document.createElement("option");
    option.innerText = "選択";
    option.hidden = true;

    if (element.value != "") {
      option.value = "";
      selectbox.appendChild(option);

      console.log(class2ndDatas);
      let datas = class2ndDatas[element.value];
      console.log(datas);
      for (let i = 0; i < datas.length; i++) {
        var option = document.createElement("option");
        option.value = datas[i]["value"];
        option.innerText = datas[i]["text"];
        selectbox.appendChild(option);
        console.log(option);
      }

      selectbox.disabled = false;
    }
  }

  function Check(element) {
    console.log(typeof element.dataset.target);

    if (typeof element.dataset.target !== "undefined") {
      let checkboxs = document.getElementsByName(element.dataset.target);
      
      for (let i = 0; i < checkboxs.length; i++) {
        checkboxs[i].checked = element.checked;
      }
    }
    else {
      let checkboxs = document.getElementsByName(element.name);
      let allCheckbox = document.querySelectorAll("[data-target='"+ element.name + "']")[0];
      console.log(allCheckbox);

      let isAllChecked = true;
      for (let i = 0; i < checkboxs.length; i++) {
        if (checkboxs[i].checked == false) { isAllChecked = false; break; }
      }

      allCheckbox.checked = isAllChecked;
    }
  }

  function AddQuestion() {
    // check question selected
    let checkboxs = document.querySelectorAll("input[name='check-question']:checked");
    if (checkboxs.length == 0) {
      alert("追加する問項を選択してください。");
      return false;
    }

    let questionNum = form.question_num.value;
    let totalPoint = Number(form.point_total.value);
    let questionIdxDatas = new Array();
    if (form.question_idxs.value != "") {
      questionIdxDatas = form.question_idxs.value.split(",");
    }

    for (let i = 0; i < checkboxs.length; i++) {
      checkboxs[i].checked = false;
      var tr = checkboxs[i].parentNode.parentNode.cloneNode(true);
      var input = tr.lastElementChild.firstElementChild;
      input.name = "check-diagnosis";

      questionNum++;
      totalPoint += Number(tr.children[5].innerText);
      questionIdxDatas.push(checkboxs[i].value);

      checkboxs[i].parentNode.parentNode.hidden = true;
      diagnosisList.lastElementChild.appendChild(tr);
    }

    console.log(questionIdxDatas);
    form.question_num.value = questionNum;
    form.point_total.value = totalPoint;
    form.question_idxs.value = questionIdxDatas.join(",");

    NumberingList();
    diagnosisCheckbox.checked = false;
    questionCheckbox.checked = false;
    questionNumText.innerText = questionNum;
    ChangeEvaluation();
    SetPopover();
  }

  function RemoveQuestion() {
    // check question selected
    let checkboxs = document.querySelectorAll("input[name='check-diagnosis']:checked");
    if (checkboxs.length == 0) {
      alert("削除する問項を選択してください。");
      return false;
    }

    let questionNum = form.question_num.value;
    let totalPoint = Number(form.point_total.value);
    let questionIdxDatas = new Array();
    if (form.question_idxs.value != "") {
      questionIdxDatas = form.question_idxs.value.split(",");
    }

    let diagnosisCheckboxDatas = document.getElementsByName("check-diagnosis");
    
    for (let i = diagnosisCheckboxDatas.length - 1; i >= 0; i--) {
      if (diagnosisCheckboxDatas[i].checked == true) {
        let questionCheckbox = document.querySelectorAll("input[name='check-question'][value='" + diagnosisCheckboxDatas[i].value + "']")[0];

        questionNum--;
        totalPoint -= Number(diagnosisCheckboxDatas[i].parentNode.parentNode.children[5].innerText);
        questionIdxDatas.splice(i, 1);

        diagnosisCheckboxDatas[i].parentNode.parentNode.remove();
        if (typeof questionCheckbox !== "undefined") {
          questionCheckbox.parentNode.parentNode.hidden = false;
        }
      }
    }

    console.log(questionIdxDatas);
    form.question_num.value = questionNum;
    form.point_total.value = totalPoint;
    form.question_idxs.value = questionIdxDatas.join(",");

    NumberingList();
    diagnosisCheckbox.checked = false;
    questionCheckbox.checked = false;
    questionNumText.innerText = questionNum;
    ChangeEvaluation();
  }

  function Confirm() {
    if (CheckValidation() == false) { return false; }
    form.submit();
  }



  function ErrorString() {
    let alertString = "予期せぬエラーが発生しました。";
    alertString += "\n管理者にエラー内容をお知らせくださいますようお願いいたします。";
    alertString += "\n\nエラー内容：";
    return alertString;
  }

  function SendXhr(route, datas = new Array()) {
    const postForm = new FormData();
    for (let i = 0; i < datas.length; i++) {
      postForm.append(datas[i]["key"], datas[i]["value"]);
    }

    const xhr = new XMLHttpRequest();
    xhr.open("POST", route, true);
    xhr.send(postForm);
    return xhr;
  }

  function NumberingList() {
    let diagnosisCheckboxs = document.getElementsByName("check-diagnosis");
    for (let i = 0; i < diagnosisCheckboxs.length; i++) {
      diagnosisCheckboxs[i].parentNode.parentNode.firstElementChild.innerText = Number(i) + 1;
    }

    let questionCheckboxs = document.getElementsByName("check-question");
    let minus = 0
    for (let i = 0; i < questionCheckboxs.length; i++) {
      questionCheckboxs[i].parentNode.parentNode.firstElementChild.innerText = Number(i) + 1 - minus;
      if (questionCheckboxs[i].parentNode.parentNode.hidden == true) { minus++; }
    }
  }

  function ChangeToPopoverForm(string) {
    string = string.replace("<", "＜");
    string = string.replace(">", "＞");
    string = string.replaceAll("{{n}}", "<br/>");
    string = string.replaceAll('"', "”");
    string = "<pre>" + string + "</pre>";
    return string;
  }

  function SetPopover() {
    let popoverTriggerList = document.querySelectorAll("[data-bs-toggle='popover']");
    let popoverList = [...popoverTriggerList].map(popoverTriggerEl => new bootstrap.Popover(popoverTriggerEl));
  }

  function ChangeEvaluation() {
    let totalPoint = Number(form.point_total.value);

    let resultPointDatas = new Array();
    for (let i = 0; i < resultPointCriteriaDatas.length; i++) {
      var resultPointEnd = totalPoint;
      if (i != 0) {
        resultPointEnd = Math.floor(totalPoint / 100 * Number(resultPointCriteriaDatas[i - 1])) - 1;
      }
      var resultPointStart = Math.floor(totalPoint / 100 * Number(resultPointCriteriaDatas[i]));

      resultPointDatas.push(resultPointStart);

      resultPointTextDatas[i].innerText = resultPointStart + " ~ " + resultPointEnd;
    }

    form.result_points.value = resultPointDatas.join(",");
  }

  function CheckValidation() {
    if (form.class1st.value == "") {
      RequestSelect(form.class1st, "大分類");
      return false;
    }

    if (form.class2nd.value == "") {
      RequestSelect(form.class2nd, "小分類");
      return false;
    }

    if (form.level.value == "") {
      RequestSelect(form.level, "レベル");
      return false;
    }

    if (form.title.value.trim() == "") {
      alert("タイトルを入力してください。");
      setTimeout("form.title.focus()", 100);
      return false;
    }

    if (form.question_idxs.value == "") {
      alert("問題を作成してください。");
      diagnosisList.focus();
      return false;
    }

    let resultTextDatas = new Array();
    let resultCommentDatas = new Array();
    for (let i = 0; i < 4; i++) {
      if (form.result_text[i].value == "") {
        alert("評価を入力してください。");
        setTimeout("form.result_text[" + i + "].focus()", 100);
        return false;
      }

      if (form.result_text[i].value.includes(",")) {
        alert("評価に「，」わ入力できません。");
        setTimeout("form.result_text[" + i + "].focus()", 100);
        return false;
      }
      resultTextDatas.push(form.result_text[i].value);

      if (form.result_comment[i].value == "") {
        alert("評価コメントを入力してください。");
        setTimeout("form.result_comment[" + i + "].focus()", 100);
        return false;
      }

      if (form.result_comment[i].value.includes(",")) {
        alert("評価コメントに「，」わ入力できません。");
        setTimeout("form.result_comment[" + i + "].focus()", 100);
        return false;
      }
      resultCommentDatas.push(form.result_comment[i].value);
    }

    form.result_texts.value = resultTextDatas.join(",");
    form.result_comments.value = resultCommentDatas.join(",");
  }

  function RequestSelect(element, text) {
    alert(text + "を選択してください");
    element.focus();
  }
</script>