<!-- ITスキル有無選択時に画面変化 -->
<script>
var skillSelect = document.querySelector('select[name="skill"]');

var questionTypeSelect = document.getElementById('typeSelect');
var questionTypeSpanSelect = document.getElementById('spanTypeSelect');

var ApplicantDevelopSelect = document.getElementById('developSelect');
var ApplicantDevelopSpanSelect=document.getElementById('spanDevelopSelect');

var otherDevelopInput = document.getElementById('otherDevelopInput');

var careerInput = document.getElementById('career');
var ApplicantCareerInput = document.getElementById('spanCareer');

var certificatesInput = document.querySelector('input[name="certificates"]');
var ApplicantCertificatesInput = document.getElementById('spanCertificates');


var otherTextarea = document.querySelector('textarea[name="other"]');
var ApplicantOtherTextarea = document.getElementById('spanOther');


skillSelect.addEventListener('change', function() {
    var selectedValue = this.value;
    if (selectedValue === '1') {
        questionTypeSelect.style.display='none';        
        questionTypeSpanSelect.style.display='none';

        ApplicantDevelopSelect.style.display='none';
        ApplicantDevelopSpanSelect.style.display='none';
        otherDevelopInput.style.display='none';

        careerInput.style.display='none';
        ApplicantCareerInput.style.display='none';
        
        certificatesInput.style.display='none';
        ApplicantCertificatesInput.style.display='none';


        questionTypeSelect.disabled=true;
        developSelect.disabled = true;
        otherDevelopInput.querySelector('input').disabled = true;
        careerInput.disabled = true;
        certificatesInput.disabled = true;
    } else {
        questionTypeSelect.style.display='block';    
        questionTypeSpanSelect.style.display='block'; 

        ApplicantDevelopSelect.style.display='block';
        ApplicantDevelopSpanSelect.style.display='block';
        otherDevelopInput.style.display='block';
        otherDevelopInput.style.display='none';

        careerInput.style.display='block';
        ApplicantCareerInput.style.display='block';

        certificatesInput.style.display='block';
        ApplicantCertificatesInput.style.display='block';


        questionTypeSelect.disabled=false;
        developSelect.disabled = false;
        otherDevelopInput.querySelector('input').disabled = false;
        careerInput.disabled = false;
        certificatesInput.disabled = false;
    }
    
});
</script>

<!-- educationとdevelopのその他項目画面変化 -->
<script>
    document.getElementById('educationSelect').addEventListener('change', function(event) {
    var selectedOption = event.target.value;
    var otherEducationInput = document.getElementById('otherEducationInput');

    if (selectedOption === "その他") {
        otherEducationInput.style.display = 'block';
    } else {
        otherEducationInput.style.display = 'none';
    }

    var otherEducation = document.getElementById('otherEducation');
    if (selectedOption === "その他") {
        otherEducation.removeAttribute('disabled');
    } else {
        otherEducation.setAttribute('disabled', 'disabled');
    }
});

    document.getElementById('developSelect').addEventListener('change', function(event) {
    var selectedOption = event.target.value;
    var otherDevelopInput = document.getElementById('otherDevelopInput');

    if (selectedOption === "その他") {
        otherDevelopInput.style.display = 'block';
    } else {
        otherDevelopInput.style.display = 'none';
    }

    var otherDevelop = document.getElementById('otherDevelop');
    if (selectedOption === "その他") {
        otherDevelop.removeAttribute('disabled');
    } else {
        otherDevelop.setAttribute('disabled', 'disabled');
    }
});

document.getElementById('majorSelect').addEventListener('change', function(event) {
    var selectedOption = event.target.value;
    var otherMajorInput = document.getElementById('otherMajorInput');

    if (selectedOption === "IT・ソフトウェア以外") {
        otherMajorInput.style.display = 'block';
    } else {
        otherMajorInput.style.display = 'none';
    }

    var otherMajor = document.getElementById('otherMajor');
    if (selectedOption === "IT・ソフトウェア以外") {
        otherMajor.removeAttribute('disabled');
    } else {
        otherMajor.setAttribute('disabled', 'disabled');
    }
});
</script>

<!-- 漢字カナ入力時有効性検査 -->
<script>
function checkKanji(input) {
    var japaneseChineseRegex = /^[\u4E00-\u9FFF]+$/; 
    return japaneseChineseRegex.test(input);
}

function checkKana(input) {
    var katakanaRegex = /^[\u30A0-\u30FFー]+$/; 
    return katakanaRegex.test(input);
}
</script>

<!-- 必須項目有効性検査 -->
<script type="text/javascript">
	function applicationConfirm() {
		if (form.email.value == "") {
			alert("メールアドレスを入力してください。");
            setTimeout("form.email.focus()",100);
            event.preventDefault();
			return false;
		}

        if (form.name.value == "" || !checkKanji(form.name.value)) {
            alert("漢字を入力してください。");
            setTimeout("form.name.focus()",100);
            event.preventDefault();

            return false;
        }

        if (form.kana.value == "" || !checkKana(form.kana.value)) {
			alert("カナを入力してください。");
            setTimeout("form.kana.focus()",100);
            event.preventDefault();
			return false;
		}
    
        if (form.application_category.value == "") {
			alert("応募区分を入力してください。");
            setTimeout("form.application_category.focus()",100);
            event.preventDefault();
			return false;
		}
        if (form.educationSelect.value == "") {
			alert("学歴入力してください。");
            setTimeout("form.educationSelect.focus()",100);
            event.preventDefault();
			return false;
		}

        if (form.educationSelect.value == "その他" && form.otherEducation.value=="") {
			alert("その他の場合の、記入してください。");
            setTimeout("form.educationSelect.focus()",100);
            event.preventDefault();
			return false;
		}


        if (form.skill.value == "") {
			alert("ITスキル有無を入力してください。");
            setTimeout("form.skill.focus()",100);
            event.preventDefault();
			return false;
		}

     
        if (!developSelect.disabled && form.developSelect.value === "") {
            alert("経験分野を入力してくださいsd。");
            setTimeout("form.developSelect.focus()",100);
            event.preventDefault(); 
            return false;
        }


        if (form.developSelect.value == "その他" && form.otherDevelop.value=="") {
			alert("その他の場合の、記入してください");
            setTimeout("form.developSelect.focus()",100);
            event.preventDefault();
			return false;
		}

        if (!careerInput.disabled && (isNaN(form.career.value) || form.career.value === "")) {
            alert("IT経験年数を入力してください。");
            setTimeout("form.careerInput.focus()",100);
            event.preventDefault(); 
            return false;
        }

        if (!typeSelect.disabled && form.typeSelect.value == "") {
			alert("問題種別を入力してください。");
            setTimeout("form.typeSelect.focus()",100);
            event.preventDefault();
			return false;
		}
        
        var submitConfirm=confirm("申し込みますか？");
        if (!submitConfirm){
            event.preventDefault();
            return false;
        }
	}

</script>

<!-- selectbox 選択時の　色 -->
<script>
var selectElements = document.querySelectorAll('[name="gender"],[name="application_category"],[name="education"],[name="skill"],[name="question_type"],[name="develop"],[name="major"]');

selectElements.forEach(function(selectElement) {
    selectElement.addEventListener('change', function() {
        var selectedValue = selectElement.value;
        
        if (selectedValue != "") {
            selectElement.style.color = 'black';
        } else {
            selectElement.style.color = 'gray';
            // selectElement.style.fontStyle = 'italic'; 
        }
    });
});
</script>




