<!-- 漢字カナ入力時有効性検査 -->
<script>
function emailValidationCheck(input){
    var emailValidation =  /^[A-Za-z0-9_\.\-]+@[A-Za-z0-9\-]+\.[A-Za-z0-9\-]+/;
    return emailValidation.test(input);
}

function isZenkaku(str) {
  for (var i = 0; i < str.length; i++) {
    var code = str.charCodeAt(i);
    if ((code >= 0x21 && code <= 0x7E) || 
        (code >= 0xAC00 && code <= 0xD7A3)) { 
      return str.charAt(i);
    }
  }
  return null;
}

function checkKana(input) {
  var katakanaRegex = /^[\u30A0-\u30FFー\s]+$/; 
  return katakanaRegex.test(input);
}
</script>

