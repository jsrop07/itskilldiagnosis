<script type="text/javascript">
	const seachName = document.getElementById("search-name");
	const seachAlign = document.getElementById("search-align");
  /*
    作成：朴昰成
    作成日：24/06/02
  */
	const searchDate = document.getElementById("search-date");
  /* ここまで */
	const check_all = document.getElementById("checkAll");
	const check_idxs = document.getElementsByName("checkIdx");

	function Checking(element) {
		if (element == check_all) {
			if (element.checked) {
				check_idxs.forEach(e => {
					if (!e.disabled) { e.checked = true; }
				});
			}
			else {
				check_idxs.forEach(e => { e.checked = false; });
			}
		}

		if (element != check_all) {
			let allChecked = true;
			for (let i = 0; i < check_idxs.length; i++) {
				if (check_idxs[i].checked == false) {
					if (check_idxs[i].disabled == true) { continue; }
					allChecked = false;
					break;
				}
			}

			check_all.checked = allChecked;
		}
	}

	function Select(value) {
		<?php
			$newQuery = "?";

			if (!empty($queryDatas)) {
				foreach ($queryDatas as $data) {
					if (explode("=", $data)[0] == "page") { continue; }
					if (explode("=", $data)[0] == "pick") { continue; }

					$newQuery .= $data . "&";
				}
			}

			$url = $route . $newQuery;
		?>

		let url = "<?php echo $url; ?>";

		if (value == "") { url = url.slice(0, -1); }
		else { url += "pick=" + value; }
		self.window.location = url;
	}
	function Search(value) {
		<?php
			$newQuery = "?";

			if (!empty($queryDatas)) {
				foreach ($queryDatas as $data) {
					if (explode("=", $data)[0] == "page") { continue; }
					if (explode("=", $data)[0] == "name") { continue; }
          /*
            作成：朴昰成
            作成日：24/06/02
          */
          if (explode("=", $data)[0] == "date") { continue; }
          /* ここまで */

					$newQuery .= $data . "&";
				}
			}

			$url = $route . $newQuery;
		?>

		let url = "<?php echo $url; ?>";

    /*
      作成：朴昰成
      修正：朴昰成
      修正前：24/06/02
    */

    /* 修正前：
      if (seachName.value.trim() == "") { url = url.slice(0, -1); }
      else { url += "name=" + seachName.value; }
      self.window.location = url;
    */

    /* 修正後： */
    if (seachName.value.trim() != "") { url += "name=" + seachName.value + "&"; }
    if (searchDate.value != "") { url += "date=" + searchDate.value + "&"; }
    url = url.slice(0, -1);

    self.window.location = url;
    /* ここまで */
	}

	function Request() {
		idxs = [];
		isChecked = false;
		for (let i = 0; i < check_idxs.length; i++) {
			if (check_idxs[i].checked == true) {
				isChecked = true;

				idxs.push(check_idxs[i].value);
			}
		}

		if (!isChecked) {
			alert("依頼するデータを選んでください。");
			return false;
		}
		idxs = idxs.join(",");

		if (confirm("依頼しますか？") === false) { return false; }

		const postForm = new FormData();
		postForm.append("idxs", idxs);
		const xhr = new XMLHttpRequest();
		xhr.open("POST", "./request", true);
		xhr.send(postForm);
		xhr.onload = () => {
			if (xhr.status == 200) {
				const result = xhr.responseText;

				if (result === "success") {
					alert("依頼しました。");
					location.reload(true);
				}
				else {
					alert("error");
					console.log(result);
				}
			}
		}
	}
  /*
    作成：朴昰成
    作成日：24/05/29
  */

  function SendMail() {
		idxs = [];
		isChecked = false;
		for (let i = 0; i < check_idxs.length; i++) {
			if (check_idxs[i].checked == true) {
				isChecked = true;

				idxs.push(check_idxs[i].value);
			}
		}

		if (!isChecked) {
			alert("送信するデータを選んでください。");
			return false;
		}
		idxs = idxs.join(",");

    if (confirm("メールを送信しますか？") === false) { return false; }

    const postForm = new FormData();
    postForm.append("idxs", idxs);
    const xhr = new XMLHttpRequest();
    xhr.open("POST", "./mail", true);
    xhr.send(postForm);
    xhr.onload = () => {
      if (xhr.status == 200) {
        const result = xhr.responseText;

        if (result === "success") {
          alert("送信しました。");
          location.reload(true);
        }
        else {
          try {
            let idxDatas = JSON.parse(result);
            alert("送信てきないデータがあります。");
            return false;
          } catch (e) {
            alert("error");
            console.log(result);
            return false;
          }
        }
      }
    }
  }
  /* ここまで */
</script>
