<script>
 function confirmExam() {
    var formData = new FormData(document.getElementById('myForm'));
    var radioIdsArray= [];
    var confirmContent = document.getElementById('confirmContent');
    confirmContent.innerHTML = '';
    for (var pair of formData.entries()) {
      var questionIdx = pair[0];
      var selectedRadio = document.querySelector('input[name="' + questionIdx + '"]:checked');
      if (selectedRadio) {
        var radioId = selectedRadio.value;
        confirmContent.innerHTML = '試験を提出しますか？';
        formData.append('answer_data', radioId);
        radioIdsArray.push(radioId);
      }      

    }

    var combinedAnswers = radioIdsArray.join(',');
    console.log(combinedAnswers);

    document.getElementById('answer_data').value = combinedAnswers;
    

      
    // var confirmData= confirmContent.innerHTML;
}
</script>

<script>
  function timeoutExam() {
    var formData = new FormData(document.getElementById('myForm'));
    var totalQuestions = <?= count($matchedData) ?>;
    var answersArray = new Array(totalQuestions).fill('');
    var confirmContent = document.getElementById('confirmContent');
    confirmContent.innerHTML = '試験を提出しますか？';

    for (var pair of formData.entries()) {
        var questionIdx = parseInt(pair[0].replace('answer', ''), 10); // 'answer' 제거 후 숫자로 변환
        var selectedRadio = document.querySelector('input[name="' + pair[0] + '"]:checked');
        if (selectedRadio) {
            var radioId = selectedRadio.value;
            answersArray[questionIdx - 1] = radioId; // question index start 1
        }
    }

    var combinedAnswers = answersArray.join(',');
    console.log(combinedAnswers);

    document.getElementById('answer_data').value = combinedAnswers;
  }


</script>
