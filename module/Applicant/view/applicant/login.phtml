<script>
	const id = document.getElementById("id");
	const password = document.getElementById("password");
	const url = window.location.href;

	function submit() {
		if (id.value == "") {
			alert("IDを入力ください");
			id.focus();
			return false;
		}

		if (password.value == "") {
			alert("パスワードを入力ください");
			password.focus();
			return false;
		}

		const postForm = new FormData();
		postForm.append("id", id.value);
		postForm.append("password", password.value);

		const xhr = new XMLHttpRequest();
		xhr.open("POST", url, true);
		xhr.send(postForm);

		xhr.onload = () => {
			if (xhr.status == 200) {
				const result = xhr.responseText;
				if (result == "wrong id") {
					alert("有効ではないIDです");
					id.focus();
				} else if (result == "wrong password") {
					alert("パスワードを確認してください");
					password.focus();
				} else if (result == "success") {
          self.location.href = "../applicant/exam";
				}
			}
		}
	}
</script>
