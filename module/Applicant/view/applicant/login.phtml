<div class="emegra card">
	<div class="card-header">G&G Service</div>

	<div class="card-body">
		<span>ログインID</span>
		<input class="form-control" name='id' id="id" type="text" placeholder="IDを入力ください">

		<span style="margin-top: 24px">パスワード</span>
		<input class="form-control" name='password' id="password" type="password" placeholder="パスワードを入力ください">

		<button class="emegra" style="margin-top: 40px;" onclick="submit();">ログイン</button>
	</div>
