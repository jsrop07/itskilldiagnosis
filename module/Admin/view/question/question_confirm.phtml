<div class="btn-place" style="margin-top: 32px;">
	<button class="emegra cancel" onclick="Return();">戻る</button>
	<button class="emegra" onclick="Regist();">確認</button>
</div>

<script type="text/javascript">
	const numTexts = ["①", "②", "③", "④", "⑤"];
	const form = document.getElementById("form");

	function Regist() {
		const postForm = new FormData(form);
		const xhr = new XMLHttpRequest();
		xhr.open("POST", "regist", true);
		xhr.send(postForm);
		xhr.onload = () => {
			if (xhr.status == 200) {
				const result = xhr.responseText;
				if (result == "success") {
					alert("登録しました。");
					self.location.href = "list";
				}
				else {
					alert("Error");
					console.log(result);
				}
			}
		}
	}

	function Return() {
		setCookie("questionData", '<?php echo json_encode($questionData); ?>', {secure: true, "max-age": 30});
		history.back();
	}
</script>