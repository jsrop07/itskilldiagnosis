function diagnosisData() {
  var skillElement = document.querySelector('select[name="skill"]');
  var levelElement = document.querySelector('select[name="level"]');
  var class2ndElement = document.querySelector('select[name="class2nd"]');
  var skillValue = skillElement.options[skillElement.selectedIndex].value;
  var levelValue = levelElement.options[levelElement.selectedIndex].value;
  var class2ndValue = class2ndElement.options[class2ndElement.selectedIndex].value;
 
  // const url = window.location.href;
  const postForm = new FormData();
  postForm.append("level", levelValue);
  postForm.append("class2nd", class2ndValue);
  const xhr = new XMLHttpRequest();
  xhr.open("POST", "../getdiagnosisdata", true);
  xhr.send(postForm);
  xhr.onload = () => {
    if (xhr.status == 200) {
      const result = xhr.responseText;
      console.log(result);

      try {
        let resultData = JSON.parse(result);
        if (result === "wrong") {
          updateTable("wrong");
          return;
        }
        updateTable(resultData);

        return false;
        } catch (e) {
          let alertString = ErrorString();
          alertString += "\nexception error in situation_edit diagnosisData";
          alertString += "\nexception message: " + e;
          alertString += "\nresponseText: " + result;
          alert(alertString);
          console.log(result);

          return false;
        }
    }
    else {
      let alertString = ErrorString();
      alertString += "\nxhr error in situation_edit diagnosisData";
      alertString += "\nerror code: " + xhr.status;
      alert(alertString);

      return false;
    }
}
}

    function updateTable(data) {
    const tableBody = document.querySelector(".table tbody");
    tableBody.innerHTML = ""; 
    if (data === "wrong" || data.length === 0) {
      const row = document.createElement("tr");
      const messageCell = document.createElement("td");
      messageCell.setAttribute("colspan", "4");
      messageCell.innerHTML = "該当する診断問題がありません。<br>経験分野、経験分野詳細、レベルを確認ください。";
      row.appendChild(messageCell);
      tableBody.appendChild(row);
    } else {
      data.forEach((item, index) => {
        const row = document.createElement("tr");

        const indexCell = document.createElement("td");
        indexCell.style="align-content:center;";
        indexCell.textContent = index + 1;
        row.appendChild(indexCell);

        const titleCell = document.createElement("td");
        titleCell.style="align-content:center;text-align:left;";
        titleCell.textContent = item.title; 
        row.appendChild(titleCell);

        const codeCell = document.createElement("td");
        codeCell.style="align-content:center";
        codeCell.textContent = item.code;
        row.appendChild(codeCell);

        const selectCell = document.createElement("td");
        selectCell.style="align-content:center";

        const button = document.createElement("button");
        button.type = "button";
        button.textContent = "選択";
        button.style="background:linear-gradient(111deg, #50D7C7 0%, #40ADF0 100%); padding: 5px 10px; color:white; border-radius:5px;";
        button.addEventListener("click", () => {
          selectCode(item.code,item.title);
          selectQuestionNum(item.question_num);
          document.querySelector('.btn-close').click();        
          // 作成：丁錫圓
          // 作成日：2406012  
          skillSelect.addEventListener("mousedown", disableEvent);
          class1stBox.addEventListener("mousedown", disableEvent);
          class2ndSelect.addEventListener("mousedown", disableEvent);
          careerSelect.addEventListener("mousedown", disableEvent);
          document.getElementById("levelId").addEventListener("mousedown", disableEvent);
          skillSelect.style.background = "#E2E2E2"
          class1stBox.style.background = "#E2E2E2"
          class2ndSelect.style.background = "#E2E2E2"
          careerSelect.style.background = "#E2E2E2"
          document.getElementById("levelId").style.background = "#E2E2E2"
          diagnosisId.hidden = true;

          const diagnosisCancel = document.createElement("button");
          diagnosisCancel.innerText = "取り消し";
          diagnosisCancel.id = "diagnosisCancel"; 
          diagnosisCancel.style="background:linear-gradient(111deg, #50D7C7 0%, #40ADF0 100%); padding: 0px 10px; color:white; border-radius:5px;"

          const parentElement = diagnosisId.parentNode; 
          parentElement.appendChild(diagnosisCancel);

          diagnosisCancel.addEventListener("click", () => {
            SkillSelectChange();
            skillSelect.removeEventListener("mousedown", disableEvent);
            class1stBox.removeEventListener("mousedown", disableEvent);
            class2ndSelect.removeEventListener("mousedown", disableEvent);
            careerSelect.removeEventListener("mousedown", disableEvent);
            document.getElementById("levelId").removeEventListener("mousedown", disableEvent);

            // Reset styles
            skillSelect.style.background = "";
            class1stBox.style.background = "";
            class2ndSelect.style.background = "";
            careerSelect.style.background = "";
            document.getElementById("levelId").style.background = "";
            diagnosisCancel.hidden = true;
            diagnosisId.hidden = false;

            event.preventDefault();
          });

          function disableEvent(event) {
            event.preventDefault(); 
          }
        /* ここまで */
        });
        
        selectCell.appendChild(button);
        row.appendChild(selectCell);

        tableBody.appendChild(row);
    });
}}

