    if (no != 1) {
      questionSelectBody.children[0].hidden = true;
    }
    else {
      questionSelectBody.children[0].hidden = false;
    }

	})

	function SetValue() {
		<?php if ($isSet): ?>
			for (let i = 0; i < selectInputs.length; i++ ) {
				var select = selectInputs.item(i);
				if (select.value == "") { select.dataset.value = ""; }
				else { select.dataset.value = "1"; }
			}
		<?php else: ?>
			for (let i = 0; i < selectInputs.length; i++ ) {
				var select = selectInputs.item(i);
				if (select.value == "") { select.dataset.value = ""; }
				else { select.dataset.value = "1"; }
			}
		<?php endif; ?>
	}

	function ChangeValue(element) { element.dataset.value = element.value; }

	function ChangeClass1st(element) {
		ChangeValue(element);

		form.class2nd.replaceChildren();
		form.class2nd.dataset.value = "";

		switch (element.value) {
			<?php foreach ($optionDatas["class2nd"] as $value => $class2nd): ?>
				case "<?php echo $value; ?>":
					var option = document.createElement("option");
					option.value = "";
					option.innerText = "選択";
					option.hidden = true;
					form.class2nd.appendChild(option);

					<?php foreach ($class2nd as $data): ?>
						var option = document.createElement("option");
						option.value = <?php echo $data["idx"]; ?>;
						option.innerText = "<?php echo $data["text"]; ?>";
						form.class2nd.appendChild(option);
					<?php endforeach; ?>
					break;
			<?php endforeach; ?>
		}
	}

	function ChangeLevel(element) {
		ChangeValue(element);

		switch (element.value) {
			<?php foreach ($resultDatas as $idx => $data): ?>
				case "<?php echo $idx; ?>":
					<?php foreach ($data as $name => $value): ?>
						form.<?php echo $name; ?>.value = "<?php echo $value; ?>";

						<?php if ($name == "point1" || $name == "point2" || $name == "point3"): ?>
							var pointElement = document.getElementById("<?php echo $name; ?>Child");
							pointElement.value = <?php echo $value - 1; ?>;
						<?php elseif ($name == "point3"): ?>
							var pointElement = document.getElementById("<?php echo $name; ?>Child");
							pointElement.value = 0;
						<?php endif; ?>
					<?php endforeach; ?>
					break;
			<?php endforeach; ?>
		}
	}

	function CreateList(element) {
		if (form.class1st.value == "") {
			RequestSelect(form.class1st, "大分類");
			return false;
		}

		if (form.class2nd.value == "") {
			RequestSelect(form.class2nd, "小分類");
			return false;
		}

		if (form.level.value == "") {
			RequestSelect(form.level, "レベル");
			return false;
		}

		const postForm = new FormData();
		postForm.append("class1st", form.class1st.value);
		postForm.append("class2nd", form.class2nd.value);
		postForm.append("level", form.level.value);
		postForm.append("question_num", form.question_num.value);

		const xhr = new XMLHttpRequest();
		<?php if ($isSet): ?>
			xhr.open("POST", "../read/question", true);
		<?php else: ?>
			xhr.open("POST", "./read/question", true);
		<?php endif; ?>
		xhr.send(postForm);
		xhr.onload = () => {
			if (xhr.status == 200) {
				const result = xhr.responseText;

				// Check is json
				try {
					questionDatas = JSON.parse(result);
				}
				catch (e) {
					alert("error");
					console.log(result);
					return false;
				}

				UpdateQuestionDatas(questionDatas);
				selectCheckboxs = questionSelectBody.getElementsByTagName("input");

        if (form.question_num.value == 0) { return 0; }

				<?php if ($isSet): ?>
					xhr.open("POST", "../read/list", true);
				<?php else: ?>
					xhr.open("POST", "./read/list", true);
				<?php endif; ?>
				xhr.send(postForm);
				xhr.onload = () => {
					if (xhr.status == 200) {
						const result = xhr.responseText;

						// Check is json
						try {
							questionIdxs = JSON.parse(result);
						}
						catch (e) {
							alert("error");
							console.log(result);
							return false;
						}

						class1st = form.class1st.value;
						class2nd = form.class2nd.value;
						level = form.level.value;

						checkboxIdxs = [];
						for (let i = 0; i < selectCheckboxs.length; i++) {
							for (let j = 0; j < questionIdxs.length; j++) {
								if (questionIdxs[j] == selectCheckboxs[i].value) {
									checkboxIdxs.push(i);
									break;
								}
							}
						}
						AddQuestionByIdxs(checkboxIdxs);
					}
				}
			}
		}
	}

	<?php if ($isSet): ?>
		function ReadList() {
			const postForm = new FormData();
			postForm.append("class1st", form.class1st.value);
			postForm.append("class2nd", form.class2nd.value);
			postForm.append("level", form.level.value);
			postForm.append("question_num", form.question_num.value);

			const xhr = new XMLHttpRequest();
			<?php if ($isEdit): ?>
				xhr.open("POST", "../read/question", true);
			<?php else: ?>
				xhr.open("POST", "./read/question", true);
			<?php endif; ?>
			xhr.send(postForm);

			xhr.onload = () => {
				if (xhr.status == 200) {
					const result = xhr.responseText;
					
					// Check is json
					try {
						questionDatas = JSON.parse(result);
					}
					catch (e) {
						alert("error");
						console.log(result);
						return false;
					}

					UpdateQuestionDatas(questionDatas);
					selectCheckboxs = questionSelectBody.getElementsByTagName("input");
					questionIdxs = form.question_idxs.value.split(",");

					checkboxIdxs = [];
					for (let i = 0; i < selectCheckboxs.length; i++) {
						for (let j = 0; j < questionIdxs.length; j++) {
							if (questionIdxs[j] == selectCheckboxs[i].value) {
								checkboxIdxs.push(i);
								break;
							}
						}
					}
					AddQuestionByIdxs(checkboxIdxs);
				}
			}
		}
	<?php endif; ?>

	function AddQuestion() {
		chkCheked = false;
		let checkboxIdxs = [];
		for (let i = 0; i < selectCheckboxs.length; i++) {
			if (selectCheckboxs[i].parentNode.parentNode.hidden == true) {
				checkboxIdxs.push(i);
			}
			else if (selectCheckboxs[i].checked == true) {
				chkCheked = true;

				checkboxIdxs.push(i);
			}
		}

		if (chkCheked) {
			AddQuestionByIdxs(checkboxIdxs);
			modal.hide();
		}
		else {
			alert("追加する問題を選択してください。");
		}
	}

	function DeleteQuestion() {
		let listCheckboxs = questionListBody.getElementsByTagName("input");

		chkCheked = false;
		let questionIdxs = form.question_idxs.value.split(",");
		let deleteIdxs = [];
		for (let i = 0; i < listCheckboxs.length; i++) {
			if (listCheckboxs[i].checked == true) {
				chkCheked = true;

				for (let j = 0; j < questionIdxs.length; j++) {
					if(questionIdxs[j] == listCheckboxs[i].value) {
						questionIdxs.splice(j, 1);
						break;
					}
				}

				deleteIdxs.push(i);
			}
		}

		if (chkCheked) {
			if (confirm("削除しますか？") === false) { return false; }

			totalNum = form.question_num.value;
			for (let i = deleteIdxs.length - 1; i >= 0; i--) {
				listCheckboxs[deleteIdxs[i]].parentNode.parentNode.remove();
				totalNum--;
			}

			totalPoint = 0;
			for (let i = 0; i < questionListBody.childNodes.length - 1; i++) {
				questionListBody.childNodes[i].childNodes[0].innerText = i + 1;
				totalPoint += Number(questionListBody.childNodes[i].childNodes[3].innerText);
			}
			listCheckbox.checked = false;
			questionListBody.lastChild.childNodes[1].innerText = totalPoint + "点";

			form.question_idxs.value = questionIdxs.join(",");
			form.question_num.value = totalNum;
      form.point_total.value = totalPoint;
		}
		else {
			alert("削除する問題を選択してください。");
		}
	}

	function ChangePoint(element) {
		let pointElement = document.getElementById(element.name + "Child");
		pointElement.value = element.value - 1;
	}

	<?php if ($isEdit): ?>
		function Update() {
			if (ChkValid() == false) { return false; }
			if (confirm("修正しますか？") === false) { return false; }

			const postForm = new FormData(form);
			const xhr = new XMLHttpRequest();
			xhr.open("POST", "../update", true);
			xhr.send(postForm);
			xhr.onload = () => {
				if (xhr.status == 200) {
					const result = xhr.responseText;
					if (result == "success") {
						alert("修正しました。");
						self.location.href = "../list";
					}
					else {
						alert("Error");
						console.log(result);
					}
				}
			}
		}
	<?php else: ?>
		function Regist() {
			if (ChkValid() == false) { return false; }
			form.submit();
		}
	<?php endif; ?>

	function RequestSelect(element, text) {
		alert(text + "を選択してください");
		element.focus();
	}

	function UpdateQuestionDatas(questionDatas) {
		questionSelectBody.replaceChildren();
		
    var tr = document.createElement("tr");
    var td = document.createElement("td");
    td.style.gridColumn = "1 / 6";
    td.innerText = "問項がありません。";
    tr.appendChild(td);
    questionSelectBody.appendChild(tr);

		for (let i = 0; i < questionDatas.length; i++) {
			let tr = document.createElement("tr");

			let td = document.createElement("td");
			td.innerText = i + 1;
			tr.appendChild(td);

			td = document.createElement("td");
			td.classList.add("left");
			td.style.overflow = "hidden";
			td.style.textOverflow = "ellipsis";
			td.style.whiteSpace = "nowrap";

			td.setAttribute("data-bs-toggle", "popover");
			td.setAttribute("data-bs-placement", "bottom");
			td.setAttribute("data-bs-title", questionDatas[i]["question"]);

			let popoverContent = numTexts[0] + ChangeSymbol(questionDatas[i]["answer1"]);
			for (let j = 2; j <= 5; j++) {
				if (questionDatas[i]["answer" + j] == null) { break; }
				popoverContent += "<br/>" + numTexts[j - 1] + ChangeSymbol(questionDatas[i]["answer" + j]);
			}
			td.setAttribute("data-bs-content", popoverContent);
			td.setAttribute("data-bs-html", "true");
			td.innerText = questionDatas[i]["title"];
			tr.appendChild(td);

			td = document.createElement("td");
			td.innerText = questionDatas[i]["type"];
			tr.appendChild(td);

			td = document.createElement("td");
			td.innerText = questionDatas[i]["point"];
			tr.appendChild(td);

			td = document.createElement("td");
			let checkbox = document.createElement("input");
			checkbox.type = "checkbox";
			checkbox.value = questionDatas[i]["idx"];
			checkbox.setAttribute("onClick", "CheckingSelect(this)");
			td.appendChild(checkbox);
			tr.appendChild(td);

			questionSelectBody.appendChild(tr);
		}
		popoverTriggerList = document.querySelectorAll("[data-bs-toggle='popover']");
		popoverList = [...popoverTriggerList].map(popoverTriggerEl => new bootstrap.Popover(popoverTriggerEl));
	}

	function ChangeSymbol(string) {
		string = string.replace(/</g, "＜");
		string = string.replace(/>/g, "＞");
		return string;
	}

	function CheckingList(element) {
		if (element.value == "") {
			for (let i = 0; i < listCheckboxs.length; i++) {
				listCheckboxs[i].checked = element.checked;
			}
			return true;
		}

		let isAllChecked = true;
		for (let i = 0; i < listCheckboxs.length; i++) {
			if (listCheckboxs[i].checked == false) {
				isAllChecked = false;
				break;
			}
		}

		listCheckbox.checked = isAllChecked;
	}

	function CheckingSelect(element) {
		if (element.value == "") {
			for (let i = 0; i < selectCheckboxs.length; i++) {
				selectCheckboxs[i].checked = element.checked;
			}
			return true;
		}

		let isAllChecked = true;
		for (let i = 0; i < selectCheckboxs.length; i++) {
			if (selectCheckboxs[i].checked == false) {
				if (selectCheckboxs[i].parentNode.parentNode.hidden == true) { continue; }
				isAllChecked = false;
				break;
			}
		}

		selectCheckbox.checked = isAllChecked;
	}

	function AddQuestionByIdxs(checkboxIdxs) {
		console.log(checkboxIdxs);
		questionListBody.replaceChildren();

		questionIdxs = [];
		totalPoint = 0;
		totalNum = 0;
		for (let i = 0; i < checkboxIdxs.length; i++) {
			let row = selectCheckboxs[checkboxIdxs[i]].parentNode.parentNode.cloneNode(true);
			row.hidden = false;
			row.childNodes[0].innerText = i + 1;
			row.childNodes[4].childNodes[0].checked = false;
			row.childNodes[4].childNodes[0].setAttribute("onClick", "CheckingList(this)");
			questionListBody.appendChild(row);
			totalPoint += Number(row.childNodes[3].innerText);

			questionIdxs.push(selectCheckboxs[checkboxIdxs[i]].value);
			totalNum++;
		}

		let tr = document.createElement("tr");
		let td = document.createElement("td");
		td.style.gridColumn = "1 / 4";
		tr.appendChild(td);

		td = document.createElement("td");
		td.innerText = totalPoint + "点";
		tr.appendChild(td);

		td = document.createElement("td");
		tr.appendChild(td);
		questionListBody.appendChild(tr);

		listCheckboxs = questionListBody.getElementsByTagName("input");
		popoverTriggerList = document.querySelectorAll("[data-bs-toggle='popover']");
		popoverList = [...popoverTriggerList].map(popoverTriggerEl => new bootstrap.Popover(popoverTriggerEl));

		form.question_idxs.value = questionIdxs.join(",");
		form.question_num.value = totalNum;
    form.point_total.value = totalPoint;
	}

	function ChkValid() {
		if (form.class1st.value == "") {
			RequestSelect(form.class1st, "大分類");
			return false;
		}

		if (form.class2nd.value == "") {
			RequestSelect(form.class2nd, "小分類");
			return false;
		}

		if (form.level.value == "") {
			RequestSelect(form.level, "レベル");
			return false;
		}

		if (form.title.value.trim() == "") {
			alert("タイトルを入力してください。");
			setTimeout("form.title.focus()", 100);
			return false;
		}

		if (form.question_idxs.value == "") {
			alert("問題を作成してください。");
			questionListBody.focus();
			return false;
		}

		if (form.class1st.value != class1st) {
			if (confirm("問題と大分類が違います。直しますか？") === true) {
				form.class1st.value = class1st;
				ChangeClass1st(form.class1st);
			}
			setTimeout("form.class1st.focus()", 100);
			return false;
		}

		if (form.class2nd.value != class2nd) {
			if (confirm("問題と小分類が違います。直しますか？") === true) {
				form.class2nd.value = class2nd;
			}
			setTimeout("form.class2nd.focus()", 100);
			return false;
		}

		if (form.level.value != level) {
			if (confirm("問題とレベルが違います。直しますか？") === true) {
				form.level.value = level;
			}
			setTimeout("form.level.focus()", 100);
			return false;
		}

		<?php for ($i = 1; $i <= 4; $i++): ?>
			if (form.point<?= $i ?>.value == "") {
				alert("評価点数を入力してください。");
				setTimeout("form.point<?= $i ?>.focus()", 100);
				return false;
			}

			if (form.text<?= $i ?>.value == "") {
				alert("評価を入力してください。");
				setTimeout("form.text<?= $i ?>.focus()", 100);
				return false;
			}

			if (form.text<?= $i ?>.value.includes(",")) {
				alert("評価に「，」わ入力できません。");
				setTimeout("form.text<?= $i ?>.focus()", 100);
				return false;
			}

			if (form.comment<?= $i ?>.value == "") {
				alert("評価コメントを入力してください。");
				setTimeout("form.comment<?= $i ?>.focus()", 100);
				return false;
			}

			if (form.comment<?= $i ?>.value.includes(",")) {
				alert("評価コメントに「，」わ入力できません。");
				setTimeout("form.comment<?= $i ?>.focus()", 100);
				return false;
			}
		<?php endfor; ?>
	}
</script>