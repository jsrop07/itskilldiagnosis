  function Approve() {
    let idxs = "";
    for (let i = 0; i < checkElements.length; i++) {
      if (checkElements[i].checked) {
        idxs += checkElements[i].value + ",";
      }
    }

    if (idxs == "") {
      alert("承認する問項を選択してください。");
      return false;
    }

    if (confirm("承認しますか？") === false) { return false; }

    const postForm = new FormData();
    postForm.append("idxs", idxs.slice(0, -1));

    const xhr = new XMLHttpRequest();
    xhr.open("POST", "approve", true);
    xhr.send(postForm);
    xhr.onload = () => {
      if (xhr.status == 200) {
        const result = xhr.responseText;

        if (result == "success") {
          alert("承認しました。");
          location.reload(true);
        }
        else {
          try {
            error = JSON.parse(result);

            switch (error["reason"]) {
              case "approved":
                let alertString = "承認できなかった問項があります。\n\n"
                alertString += "承認できなかった問項";

                let questionIdxDatas = error["data"];
                for (let i = 0; i < questionIdxDatas.length; i++) {
                  for (let j = 0; j < checkElements.length; j++) {
                    if (questionIdxDatas[i] == checkElements[j].value) {
                      alertString += "\n" + checkElements[j].parentNode.parentNode.children[0].innerText + "．" + checkElements[j].parentNode.parentNode.children[5].innerText;
                    }
                  }
                }

                alert(alertString);
                return false;
            }
            alert("error");
            console.log(result);
            return false;
          }
          catch (e) {
            alert("error");
            console.log(result);
            return false;
          }
        }
      }
    }
  }

  function Remove() {
    let idxs = "";
    for (let i = 0; i < checkElements.length; i++) {
      if (checkElements[i].checked) {
        idxs += checkElements[i].value + ",";
      }
    }

    if (idxs == "") {
      alert("削除する問項を選択してください。");
      return false;
    }

    if (confirm("削除しますか？") === false) { return false; }

    const postForm = new FormData();
    postForm.append("idxs", idxs.slice(0, -1));

    const xhr = new XMLHttpRequest();
    xhr.open("POST", "remove", true);
    xhr.send(postForm);
    xhr.onload = () => {
      if (xhr.status == 200) {
        const result = xhr.responseText;
        if (result == "success") {
          alert("削除しました。");
          location.reload(true);
        }
        else {
          alert("Error");
          console.log($result);
        }
      }
    }
  }
