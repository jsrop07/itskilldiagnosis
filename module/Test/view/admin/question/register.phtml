<div class="btn-place" style="margin-top: 32px;">
	<button class="emegra cancel" onclick="window.location.href='../question/list?page=1';" id="cancel-bt">キャンセル</button>
	<button class="emegra" onclick="confirm();">次へ</button>
</div>

<script type="text/javascript">
	const form = document.getElementById("form");

	function determineCheckboxActivation(event) {
		if (event.target.value == "" || event.target.value < 2) { form.major.disabled = true; }
		else { form.major.disabled = false; }
	}

	function confirm() {
		if (form.type.value == "") {
			alert("種別を入力してください");
			form.type.focus();
			return false;
		} 

		if (form.academic.value.trim() == "") {
			alert("最終学歴を入力してください");
			form.academic.focus();
			return false;
		} 

		if ((question.value.trim()) == "") {
			alert("問題を入力ください");
			question.focus();
			return false;
		}
		if ((answer1.value.trim()) == "") {
			alert("選択肢①を入力ください");
			answer1.focus();
			return false;
		}
		if ((answer2.value.trim()) == "") {
			alert("選択肢②を入力ください");
			answer2.focus();
			return false;
		}
		if (((answer3.value.trim()) == "") && !((answer4.value.trim()) == "")) {
			alert("順番に入力してください");
			answer3.focus();
			return false;
		}
		if (((answer4.value.trim()) == "") && !((answer5.value.trim()) == "")) {
			alert("順番に入力してください");
			answer4.focus();
			return false;
		}
		if ((correct.value == 3) && ((answer3.value.trim()) == "")) {
			alert("正解に該当する問題を入力してください");
			answer3.focus();
			return false;
		}
		if ((correct.value == 4) && ((answer4.value.trim()) == "")) {
			alert("正解に該当する問題を入力してください");
			answer4.focus();
			return false;
		}
		if ((correct.value == 5) && ((answer5.value.trim()) == "")) {
			alert("正解に該当する問題を入力してください");
			answer5.focus();
			return false;
		}

		form.typeTitle.value = type.options[type.selectedIndex].text;
		form.submit();
	}
</script>
