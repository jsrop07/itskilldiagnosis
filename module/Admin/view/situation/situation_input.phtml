      yesSkillClass2ndoption.innerText = "選択してください。";
      class2ndSelect.appendChild(yesSkillClass2ndoption);
      class1stSelect.removeAttribute('disabled');
      class2ndSelect.removeAttribute('disabled');
      careerSelect.removeAttribute('disabled');
      hiddenClass1st.setAttribute('disabled', 'disabled');
      hiddenClass2nd.setAttribute('disabled', 'disabled');
      hiddenCareer.setAttribute('disabled', 'disabled');
    }
  }	


</script>

