<script type="text/javascript">
	const input_register = document.getElementById("input_register");

	function SearchRegister() {
		let register = input_register.value;
		self.window.location = window.location.pathname + "?register=" + register;
	}

	function Regist() {
		let idxs = document.getElementsByName("idxCheck");
		let idxDatas = "";

		idxs.forEach(element => { 
			if (element.checked) {
				idxDatas += element.value + ",";
			}
		});

		const postForm = new FormData();
		postForm.append("idxs", idxDatas.slice(0, -1));

		const xhr = new XMLHttpRequest();
		xhr.open("POST", "approve", true);
		xhr.send(postForm);
		
		xhr.onload = () => {
			if (xhr.status == 200) {
				const result = xhr.responseText;
				if (result == "success") {
					alert("承認しました。");
					self.location.href = "list";
				}
				else { alert("Error"); }
				console.log(result);
			}
		}
	}
</script>
