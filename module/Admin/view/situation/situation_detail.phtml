<script type="text/javascript">
	const idx = <?php echo $recordData["idx"]; ?>

  function Request(button) {
		if (confirm("依頼しますか？") === false) { return false; }

    /*
      作成：朴昰成
      作成日：24/06/12
    */
    if (<?php echo $isExpire; ?>) {
      alert("診断予定日時を確認してください。");
      return false;
    }

    /* ここまで */
    button.replaceChildren();

    var span = document.createElement("span");
    span.classList.add("spinner-border");
    span.classList.add("spinner-border-sm");
    span.ariaHidden = "true";
    button.appendChild(span);

    var span = document.createElement("span");
    span.role = "status";
    span.innerText = "送信中...";
    button.appendChild(span);
    /*
      作成：朴昰成
      作成日：24/06/12
    */
    button.disabled = true;
    /* ここまで */

		const postForm = new FormData();
		postForm.append("idxs", idx);
		const xhr = new XMLHttpRequest();
		xhr.open("POST", "../request", true);
		xhr.send(postForm);
		xhr.onload = () => {
			if (xhr.status == 200) {
				const result = xhr.responseText;

				if (result === "success") {
					alert("依頼しました。");
					self.location.href = "../list";
				}
				else {
					alert("error");
					console.log(result);
				}
			}
		}
    /*
      作成：朴昰成
      作成日：24/06/12
    */
    location.reload(true);
    /* ここまで */
	}

  function SendMail(button) {
    if (confirm("結果を送信しますか？") === false) { return false; }

    button.replaceChildren();

    var span = document.createElement("span");
    span.classList.add("spinner-border");
    span.classList.add("spinner-border-sm");
    span.ariaHidden = "true";
    button.appendChild(span);

    var span = document.createElement("span");
    span.role = "status";
    span.innerText = "送信中...";
    button.appendChild(span);
    /*
      作成：朴昰成
      作成日：24/06/12
    */
    button.disabled = true;
    /* ここまで */

    const postForm = new FormData();
    postForm.append("idxs", idx);
    const xhr = new XMLHttpRequest();
    xhr.open("POST", "../mail", true);
    xhr.send(postForm);
    xhr.onload = () => {
      if (xhr.status == 200) {
        const result = xhr.responseText;

        if (result === "success") {
          alert("送信しました。");
          location.reload(true);
        }
        else {
          try {
            let idxDatas = JSON.parse(result);
            alert("すでに送信しました。");
            location.reload(true);
            return false;
          } catch (e) {
            alert("error");
            console.log(result);
            /*
              作成：朴昰成
              作成日：24/06/12
            */
            location.reload(true);
            /* ここまで */
            return false;
          }
        }
      }
    }
  }
</script>