<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
<script type="text/javascript">
  <?php if ($isApprover): ?>
    function Remove() {
      if (confirm("削除しますか？") === false) { return false; }

      const postForm = new FormData();
      postForm.append("idxs", <?php echo $diagnosisData["idx"]; ?>);

      const xhr = new XMLHttpRequest();
      xhr.open("POST", "../remove", true);
      xhr.send(postForm);
      xhr.onload = () => {
        if (xhr.status == 200) {
          const result = xhr.responseText;
          if (result == "success") {
            alert("削除しました。");
            self.location.href = "../list";
          }
          else {
            let alertString = ErrorString();
            alertString += "\nresponse text is not success in diagnosois_detail Remove";
            alertString += "\nresponseText: " + result;
            alert(alertString);
            console.log(result);

            return false;
          }
        }
        else {
          let alertString = ErrorString();
          alertString += "\nxhr error in diagnosois_detail Remove";
          alertString += "\nerror code: " + xhr.status;
          alert(alertString);

          return false;
        }
      }
    }
  <?php endif; ?>



  function ErrorString() {
    let alertString = "予期せぬエラーが発生しました。";
    alertString += "\n管理者にエラー内容をお知らせくださいますようお願いいたします。";
    alertString += "\n\nエラー内容：";
    return alertString;
  }
</script>