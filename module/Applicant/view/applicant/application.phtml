        <br>

        <span>ITスキル有無</span>
		<select class="form-select" name="type" style="width:20%">
            <option value="" selected="" disabled="" hidden="">有</option>
            <option value="develop_java">有</option>
            <option value="develop_java">無</option>
        </select>
