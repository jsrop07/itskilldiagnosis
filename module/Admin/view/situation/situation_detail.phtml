<script type="text/javascript">
	const idx = <?php echo $recordData["idx"]; ?>

  const buttonElements = document.getElementsByTagName("button");

  function Request(button) {
		if (confirm("診断予定日時は <?php echo $recordData["date_schedule"]; ?>です。\n依頼しますか？") === false) { return false; }

    <?php
      $isExpire = false;
      if (isset($recordData["date_schedule"])) {
        if ((strtotime($recordData["date_schedule"]) < time()) && is_null($recordData["rank"])) {
          $isExpire = true;
        }
      }
    ?>
    if (<?php echo ($isExpire) ? "true" : "false"; ?>) {
      alert("診断予定日時を確認してください。");
      return false;
    }

    ChangeButton(button, "送信中...");

    formDatas = [{"key":"idxs", "value":idx}];
    const xhr = SendXhr("../request", formDatas);
		xhr.onload = () => {
			if (xhr.status == 200) {
				const result = xhr.responseText;
        console.log(result);

				if (result === "success") {
					alert("依頼しました。");
					self.location.href = "../list";
				}
				else {
          try {
            recordDatas = JSON.parse(result);
          }
          catch (e) {
            let alertString = ErrorString();
            alertString += "\nexception error in situation_detail Request";
            alertString += "\nexception message: " + e;
            alertString += "\nresponseText: " + result;
            alert(alertString);

            ReturnButton(button, "ITスキル診断依頼");
            return false;
          }

          $alertString = "すでに依頼した診断者です。";
          alert(alertString);

					location.reload(true);
          return false;
				}
			}
      else {
        let alertString = ErrorString();
        alertString += "\nxhr error in situation_detail Request";
        alertString += "\nerror code: " + xhr.status;
        alert(alertString);

        ReturnButton(button, "ITスキル診断依頼");
        return false;
      }
		}
	}

  function SendMail(button) {
    if (confirm("結果を送信しますか？") === false) { return false; }

    ChangeButton(button, "送信中...");

    formDatas = [{"key":"idxs", "value":idx}];
    const xhr = SendXhr("../mail", formDatas);
    xhr.onload = () => {
      if (xhr.status == 200) {
        const result = xhr.responseText;

        if (result === "success") {
          alert("送信しました。");
          location.reload(true);
        }
        else {
          try {
            let idxDatas = JSON.parse(result);
          }
          catch (e) {
            let alertString = ErrorString();
            alertString += "\nexception error in situation_detail SendMail";
            alertString += "\nexception message: " + e;
            alertString += "\nresponseText: " + result;
            alert(alertString);

            ReturnButton(button, "結果送信");
            return false;
          }

          alert("すでに結果を送信した診断者です。");

          location.reload(true);
          return false;
        }
      }
      else {
        let alertString = ErrorString();
        alertString += "\nxhr error in situation_detail SendMail";
        alertString += "\nerror code: " + xhr.status;
        alert(alertString);

        ReturnButton(button, "結果送信");
        return false;
      }
    }
  }



  function ErrorString() {
    let alertString = "予期せぬエラーが発生しました。";
    alertString += "\n管理者にエラー内容をお知らせくださいますようお願いいたします。";
    alertString += "\n\nエラー内容：";
    return alertString;
  }

  function ChangeButton(button, text) {
    button.replaceChildren();

    var span = document.createElement("span");
    span.classList.add("spinner-border");
    span.classList.add("spinner-border-sm");
    span.ariaHidden = "true";
    button.appendChild(span);

    var span = document.createElement("span");
    span.role = "status";
    span.innerText = text;
    button.appendChild(span);
    
    for (let i = 0; i < buttonElements.length; i++) {
      buttonElements[i].disabled = true;
    }
  }

  function ReturnButton(button, text) {
    button.replaceChildren();
    button.innerText = text;
    
    for (let i = 0; i < buttonElements.length; i++) {
      buttonElements[i].disabled = false;
    }
  }

  function SendXhr(route, datas = new Array()) {
    const postForm = new FormData();
    for (let i = 0; i < datas.length; i++) {
      postForm.append(datas[i]["key"], datas[i]["value"]);
    }

    const xhr = new XMLHttpRequest();
    xhr.open("POST", route, true);
    xhr.send(postForm);
    return xhr;
  }
</script>